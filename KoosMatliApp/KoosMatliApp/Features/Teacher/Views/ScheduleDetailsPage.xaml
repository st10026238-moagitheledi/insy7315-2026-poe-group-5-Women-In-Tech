<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="KoosMatliApp.Features.Teacher.Views.ScheduleDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Schedule Details"
    BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>

        <VerticalStackLayout
            Padding="12,10,12,24"
            Spacing="14">


            <!-- Header -->

            <Border
                BackgroundColor="{StaticResource PrimaryBlue}"
                StrokeThickness="0"
                Padding="12">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Grid
                    ColumnDefinitions="32,*"
                    ColumnSpacing="10">

                    <Label
                        Text="‹"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="{StaticResource SunshineGold}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Label.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="OnBackTapped" />

                        </Label.GestureRecognizers>

                    </Label>


                    <Label
                        Grid.Column="1"
                        Text="Schedule Details"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="{StaticResource SunshineGold}"
                        VerticalOptions="Center" />

                </Grid>

            </Border>


            <Border
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource Gray200}"
                StrokeThickness="1"
                Padding="12">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>


                <VerticalStackLayout Spacing="14">

                    <Entry
                        Text="{Binding Title}"
                        Placeholder="Title" />


                    <Editor
                        Text="{Binding Description}"
                        Placeholder="Description"
                        MinimumHeightRequest="90"
                        AutoSize="TextChanges" />


                    <Picker
                        ItemsSource="{Binding EventTypeOptions}"
                        SelectedItem="{Binding EventType}" />


                    <DatePicker
                        Date="{Binding Date}" />


                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">

                        <TimePicker
                            Time="{Binding StartTime}" />

                        <TimePicker
                            Grid.Column="1"
                            Time="{Binding EndTime}" />

                    </Grid>


                    <VerticalStackLayout
                        IsVisible="{Binding IsClass}"
                        Spacing="12">

                        <Picker
                            ItemsSource="{Binding GradeOptions}"
                            SelectedItem="{Binding Grade}" />

                        <Picker
                            ItemsSource="{Binding SubjectOptions}"
                            SelectedItem="{Binding Subject}" />

                    </VerticalStackLayout>


                    <Entry
                        Text="{Binding Location}"
                        Placeholder="Location" />

                </VerticalStackLayout>

            </Border>


            <Button
                Text="Save Changes"
                Clicked="OnSaveChangesClicked"
                BackgroundColor="{StaticResource SunshineGold}"
                TextColor="{StaticResource PrimaryBlue}"
                FontAttributes="Bold"
                HeightRequest="46"
                CornerRadius="8" />


            <Button
                Text="Delete Schedule Item"
                Clicked="OnDeleteScheduleClicked"
                BackgroundColor="{StaticResource White}"
                TextColor="#B42318"
                BorderColor="#B42318"
                BorderWidth="1"
                FontAttributes="Bold"
                HeightRequest="46"
                CornerRadius="8" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>