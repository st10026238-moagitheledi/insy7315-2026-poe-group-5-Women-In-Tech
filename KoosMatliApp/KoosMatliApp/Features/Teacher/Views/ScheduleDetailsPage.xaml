<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="KoosMatliApp.Features.Teacher.Views.ScheduleDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:KoosMatliApp.Resources.Localization"
    Title="{localization:Translate Key=ScheduleDetails}"
    BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>

        <VerticalStackLayout
            Padding="12,10,12,24"
            Spacing="14">


            <!-- Header -->

            <Border
                BackgroundColor="{StaticResource PrimaryBlue}"
                StrokeThickness="0"
                Padding="12">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Grid
                    ColumnDefinitions="32,*"
                    ColumnSpacing="10">

                    <Label
                        Text="‹"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="{StaticResource SunshineGold}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Label.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="OnBackTapped" />

                        </Label.GestureRecognizers>

                    </Label>


                    <Label
                        Grid.Column="1"
                        Text="{localization:Translate Key=ScheduleDetails}"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="{StaticResource SunshineGold}"
                        VerticalOptions="Center" />

                </Grid>

            </Border>


            <Border
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource Gray200}"
                StrokeThickness="1"
                Padding="12">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>


                <VerticalStackLayout Spacing="14">

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="{localization:Translate Key=Title}"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PrimaryBlue}" />

                        <Entry
                            Text="{Binding Title}" />

                    </VerticalStackLayout>


                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="{localization:Translate Key=Description}"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PrimaryBlue}" />

                        <Editor
                            Text="{Binding Description}"
                            MinimumHeightRequest="90"
                            AutoSize="TextChanges" />

                    </VerticalStackLayout>


                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="{localization:Translate Key=EventType}"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PrimaryBlue}" />

                        <Picker
                            ItemsSource="{Binding EventTypeOptions}"
                            SelectedItem="{Binding EventType}" />

                    </VerticalStackLayout>


                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="{localization:Translate Key=Date}"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PrimaryBlue}" />

                        <DatePicker
                            Date="{Binding Date}" />

                    </VerticalStackLayout>


                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="{localization:Translate Key=StartTime}"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{StaticResource PrimaryBlue}" />

                            <TimePicker
                                Time="{Binding StartTime}" />

                        </VerticalStackLayout>


                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="5">

                            <Label
                                Text="{localization:Translate Key=EndTime}"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{StaticResource PrimaryBlue}" />

                            <TimePicker
                                Time="{Binding EndTime}" />

                        </VerticalStackLayout>

                    </Grid>


                    <VerticalStackLayout
                        IsVisible="{Binding IsClass}"
                        Spacing="12">

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="{localization:Translate Key=Grade}"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{StaticResource PrimaryBlue}" />

                            <Picker
                                ItemsSource="{Binding GradeOptions}"
                                SelectedItem="{Binding Grade}" />

                        </VerticalStackLayout>


                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="{localization:Translate Key=Subject}"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{StaticResource PrimaryBlue}" />

                            <Picker
                                ItemsSource="{Binding SubjectOptions}"
                                SelectedItem="{Binding Subject}" />

                        </VerticalStackLayout>

                    </VerticalStackLayout>


                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="{localization:Translate Key=Location}"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PrimaryBlue}" />

                        <Entry
                            Text="{Binding Location}" />

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>


            <Button
                Text="{localization:Translate Key=SaveChanges}"
                Clicked="OnSaveChangesClicked"
                BackgroundColor="{StaticResource SunshineGold}"
                TextColor="{StaticResource PrimaryBlue}"
                FontAttributes="Bold"
                HeightRequest="46"
                CornerRadius="8" />


            <Button
                Text="{localization:Translate Key=DeleteScheduleItem}"
                Clicked="OnDeleteScheduleClicked"
                BackgroundColor="{StaticResource White}"
                TextColor="#B42318"
                BorderColor="#B42318"
                BorderWidth="1"
                FontAttributes="Bold"
                HeightRequest="46"
                CornerRadius="8" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>