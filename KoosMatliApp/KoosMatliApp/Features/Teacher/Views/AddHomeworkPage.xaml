<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="KoosMatliApp.Features.Teacher.Views.AddHomeworkPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:KoosMatliApp.Resources.Localization"
    Title="{localization:Translate Key=AddHomework}"
    BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>

        <VerticalStackLayout
            Padding="12,10,12,24"
            Spacing="14">


            <!-- Header -->

            <Border
                BackgroundColor="{StaticResource PrimaryBlue}"
                StrokeThickness="0"
                Padding="12">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Grid
                    ColumnDefinitions="32,*"
                    ColumnSpacing="10">

                    <Label
                        Text="‹"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="{StaticResource SunshineGold}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnBackTapped" />
                        </Label.GestureRecognizers>

                    </Label>


                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="1"
                        VerticalOptions="Center">

                        <Label
                            Text="{localization:Translate Key=AddHomework}"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{StaticResource SunshineGold}" />

                        <Label
                            Text="{Binding Grade}"
                            FontSize="9"
                            TextColor="{StaticResource White}" />

                        <Label
                            Text="{Binding Subject}"
                            FontSize="9"
                            TextColor="{StaticResource White}" />

                    </VerticalStackLayout>

                </Grid>

            </Border>


            <!-- Homework Details -->

            <Label
                Text="{localization:Translate Key=HomeworkDetails}"
                FontSize="15"
                FontAttributes="Bold"
                TextColor="{StaticResource PrimaryBlue}" />


            <Border
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource Gray200}"
                StrokeThickness="1"
                Padding="12">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">


                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="{localization:Translate Key=Title}"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PrimaryBlue}" />

                        <Entry
                            Text="{Binding Title}"
                            FontSize="11"
                            TextColor="{StaticResource Charcoal}" />

                    </VerticalStackLayout>


                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="{localization:Translate Key=Instructions}"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PrimaryBlue}" />

                        <Editor
                            Text="{Binding Description}"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="100"
                            FontSize="11"
                            TextColor="{StaticResource Charcoal}" />

                    </VerticalStackLayout>


                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="{localization:Translate Key=DueDate}"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PrimaryBlue}" />

                        <DatePicker
                            Date="{Binding DueDate}"
                            MinimumDate="2024-01-01"
                            TextColor="{StaticResource Charcoal}" />

                    </VerticalStackLayout>


                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="{localization:Translate Key=Status}"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PrimaryBlue}" />

                        <Picker
                            SelectedItem="{Binding Status}"
                            TextColor="{StaticResource Charcoal}">

                            <Picker.Items>

                                <x:String>Assigned</x:String>

                                <x:String>Draft</x:String>

                            </Picker.Items>

                        </Picker>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>


            <!-- Attachment -->

            <Label
                Text="{localization:Translate Key=Attachment}"
                FontSize="15"
                FontAttributes="Bold"
                TextColor="{StaticResource PrimaryBlue}" />


            <Border
                BackgroundColor="{StaticResource PrimaryBlueSoft}"
                StrokeThickness="0"
                Padding="12">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="{localization:Translate Key=Attachment}"
                        FontSize="9"
                        TextColor="{StaticResource PrimaryBlue}" />


                    <Button
                        Text="{localization:Translate Key=ChooseFile}"
                        Clicked="OnChooseFileClicked"
                        BackgroundColor="{StaticResource White}"
                        TextColor="{StaticResource PrimaryBlue}"
                        BorderColor="{StaticResource PrimaryBlue}"
                        BorderWidth="1"
                        FontSize="10"
                        CornerRadius="8"
                        HeightRequest="42" />


                    <Label
                        Text="{Binding AttachmentName}"
                        FontSize="9"
                        TextColor="{StaticResource Gray500}"
                        LineBreakMode="TailTruncation" />

                </VerticalStackLayout>

            </Border>


            <!-- Save -->

            <Button
                Text="{localization:Translate Key=SaveHomework}"
                Clicked="OnSaveHomeworkClicked"
                BackgroundColor="{StaticResource SunshineGold}"
                TextColor="{StaticResource PrimaryBlue}"
                FontAttributes="Bold"
                FontSize="11"
                HeightRequest="46"
                CornerRadius="8" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>