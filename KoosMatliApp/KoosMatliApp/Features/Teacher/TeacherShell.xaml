<?xml version="1.0" encoding="utf-8" ?>

<Shell
    x:Class="KoosMatliApp.Features.Teacher.TeacherShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:KoosMatliApp.Features.Teacher.Views"
    FlyoutBehavior="Disabled">

    <TabBar>

        <ShellContent
            Title="Home"
            Icon="nav_home.svg"
            Route="TeacherHome"
            ContentTemplate="{DataTemplate views:TeacherHomePage}" />

        <ShellContent
            Title="Classes"
            Icon="nav_classes.svg"
            Route="TeacherClasses"
            ContentTemplate="{DataTemplate views:ClassesPage}" />

        <ShellContent
            Title="Updates"
            Icon="nav_updates.svg"
            Route="TeacherUpdates"
            ContentTemplate="{DataTemplate views:UpdatesPage}" />

        <ShellContent
            Title="Schedule"
            Icon="nav_schedule.svg"
            Route="TeacherSchedule"
            ContentTemplate="{DataTemplate views:SchedulePage}" />

        <ShellContent
            Title="Profile"
            Icon="nav_profile.svg"
            Route="TeacherProfile"
            ContentTemplate="{DataTemplate views:ProfilePage}" />

    </TabBar>

</Shell>