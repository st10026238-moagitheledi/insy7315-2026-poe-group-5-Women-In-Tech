<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KoosMatliApp.Views.Admin.SchoolDatesPage"
    Title="School Dates">

    <Grid Padding="20"
          RowDefinitions="Auto,*"
          RowSpacing="15">

        <VerticalStackLayout Spacing="12">

            <Button
                Text="← Back to Dashboard"
                HorizontalOptions="Start"
                BackgroundColor="Transparent"
                TextColor="Black"
                Clicked="BackButton_Clicked" />

            <Label
                Text="School Dates"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="Manage important academic dates"
                TextColor="Gray" />

            <Button
                Text="+ Add School Date"
                HorizontalOptions="Start"
                Command="{Binding ShowAddFormCommand}" />

            <Border
                IsVisible="{Binding IsAddFormVisible}"
                Padding="15"
                Stroke="#DDDDDD"
                StrokeShape="RoundRectangle 10">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Add a School Date"
                        FontSize="20"
                        FontAttributes="Bold" />

                    <Label Text="Title" />

                    <Entry
                        Placeholder="e.g. Parent Meeting"
                        Text="{Binding NewTitle}" />

                    <Label Text="Date" />

                    <DatePicker
                        Date="{Binding NewDate}"
                        Format="dd MMMM yyyy" />

                    <Label Text="Description (optional)" />

                    <Editor
                        Placeholder="Enter additional details"
                        Text="{Binding NewDescription}"
                        AutoSize="TextChanges"
                        HeightRequest="80" />

                    <Label
                        Text="{Binding ErrorMessage}"
                        TextColor="Red"
                        IsVisible="{Binding HasError}" />

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}" />

                    <HorizontalStackLayout Spacing="10">

                        <Button
                            Text="Save Date"
                            Command="{Binding SaveDateCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />

                        <Button
                            Text="Cancel"
                            Command="{Binding CancelAddCommand}"
                            BackgroundColor="Gray" />

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Border>

            <Label
                Text="Upcoming School Dates"
                FontSize="20"
                FontAttributes="Bold" />

            <Label
                Text="{Binding ErrorMessage}"
                TextColor="Red"
                IsVisible="{Binding HasError}" />

        </VerticalStackLayout>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding SchoolDates}"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Padding="20"
                    Spacing="8"
                    HorizontalOptions="Center">

                    <Label
                        Text="No school dates found."
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Add a school date to get started."
                        TextColor="Gray"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        Padding="15"
                        Margin="0,5"
                        Stroke="#DDDDDD"
                        StrokeShape="RoundRectangle 10">

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="15">

                            <Border
                                Padding="10"
                                BackgroundColor="#EEEEEE"
                                StrokeShape="RoundRectangle 8"
                                VerticalOptions="Start">

                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        Text="{Binding DayNumber}"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center" />

                                    <Label
                                        Text="{Binding MonthName}"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>

                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="5">

                                <Label
                                    Text="{Binding Title}"
                                    FontAttributes="Bold"
                                    FontSize="17" />

                                <Label
                                    Text="{Binding FormattedDate}"
                                    TextColor="Gray"
                                    FontSize="13" />

                                <Label
                                    Text="{Binding Description}"
                                    FontSize="14" />

                            </VerticalStackLayout>

                        </Grid>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>