<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KoosMatliApp.Views.Admin.Schooldetailspage"
    Title="School Details">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="School Details"
                FontSize="28"
                FontAttributes="Bold" />

            <Label Text="School Name" />
            <Entry Text="Koos Matli Primary School" />

            <Label Text="Address" />
            <Editor
                Placeholder="School address"
                AutoSize="TextChanges" />

            <Label Text="Telephone Number" />
            <Entry
                Placeholder="Telephone number"
                Keyboard="Telephone" />

            <Label Text="Email Address" />
            <Entry
                Placeholder="Email address"
                Keyboard="Email" />

            <Label Text="Principal" />
            <Entry Placeholder="Principal name" />

            <Button Text="Save School Details" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>