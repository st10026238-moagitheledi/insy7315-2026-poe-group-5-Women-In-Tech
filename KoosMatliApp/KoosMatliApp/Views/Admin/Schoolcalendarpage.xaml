<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:vm="clr-namespace:KoosMatliApp.ViewModels" xmlns:model="clr-namespace:KoosMatliApp.Models" x:DataType="vm:SchoolDetailsViewModel" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="KoosMatliApp.Views.Admin.Schoolcalendarpage" Title="{DynamicResource T_2A31515574F6}">
<Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="12">
<Label Text="{DynamicResource T_2A31515574F6}" FontSize="28" FontAttributes="Bold"/>
<VerticalStackLayout Grid.Row="1"><Label Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding HasError}"/>
<Button Text="{DynamicResource T_57D208BC0D04}" Command="{Binding AddEventCommand}"/></VerticalStackLayout>
<CollectionView Grid.Row="2" ItemsSource="{Binding Events}" SelectionMode="None">
<CollectionView.EmptyView><Label Text="{DynamicResource T_204BEB801DEB}"/></CollectionView.EmptyView>
<CollectionView.ItemTemplate><DataTemplate x:DataType="model:CalendarEvent"><VerticalStackLayout Padding="12" Spacing="6">
<Label Text="{Binding Title}" FontAttributes="Bold"/><Label Text="{Binding Start, Converter={StaticResource LocalTime}}"/>
<Label Text="{Binding End, Converter={StaticResource LocalTime}}"/><Label Text="{Binding Description}"/>
</VerticalStackLayout></DataTemplate></CollectionView.ItemTemplate>
</CollectionView></Grid></ContentPage>
