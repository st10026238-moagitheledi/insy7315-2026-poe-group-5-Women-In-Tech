<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KoosMatliApp.Views.Admin.StaffPage"
    Title="Staff">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="15">

        <VerticalStackLayout>
            <Label
                Text="Staff &amp; Scheduling"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="View teachers, classes and subjects"
                TextColor="Gray" />
        </VerticalStackLayout>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,*,*"
            ColumnSpacing="8">

            <Button
                Grid.Column="0"
                Text="Teachers" />

            <Button
                Grid.Column="1"
                Text="Classes" />

            <Button
                Grid.Column="2"
                Text="Subjects" />

        </Grid>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Staff}">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        Padding="15"
                        Margin="0,5"
                        Stroke="#DDDDDD"
                        StrokeShape="RoundRectangle 10">

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="{Binding FullName}"
                                FontAttributes="Bold"
                                FontSize="16" />

                            <Label
                                Text="{Binding Position, StringFormat='Position: {0}'}"
                                FontSize="13" />

                            <Label
                                Text="{Binding Subjects}"
                                FontSize="13"
                                TextColor="Gray" />

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>