<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KoosMatliApp.Views.Admin.applicationspage"
    Title="Applications">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="15">

        <VerticalStackLayout>
            <Label
                Text="Applications"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="Review learner admission applications"
                TextColor="Gray" />
        </VerticalStackLayout>

        <SearchBar
            Grid.Row="1"
            Placeholder="Search application number or learner..." />

        <!-- STATUS FILTERS -->
        <ScrollView
            Grid.Row="2"
            Orientation="Horizontal">

            <HorizontalStackLayout Spacing="8">

                <Button Text="New" />
                <Button Text="Pending" />
                <Button Text="Approved" />
                <Button Text="Rejected" />

            </HorizontalStackLayout>

        </ScrollView>

        <!-- APPLICATION LIST -->
        <CollectionView Grid.Row="3" ItemsSource="{Binding Applications}">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        Padding="15"
                        Margin="0,5"
                        Stroke="#DDDDDD"
                        StrokeShape="RoundRectangle 10">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="{Binding ApplicationNumber}"
                                    FontAttributes="Bold"
                                    FontSize="16" />

                                <Label
                                    Text="{Binding LearnerFullName}"
                                    FontSize="14" />

                                <Label
                                    Text="{Binding Status}"
                                    FontSize="13"
                                    TextColor="Orange" />

                            </VerticalStackLayout>

                            <Label
                                Grid.Column="1"
                                Text="›"
                                FontSize="25"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>