<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KoosMatliApp.Views.Admin.UserPage"
    Title="Users">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="15">

        <!-- HEADER -->
        <VerticalStackLayout>
            <Label
                Text="Users"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="View registered parents, teachers and learners"
                TextColor="Gray" />
        </VerticalStackLayout>

        <!-- SEARCH -->
        <SearchBar
            Grid.Row="1"
            Placeholder="Search users..." />

        <!-- FILTER BUTTONS -->
        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,*,*"
            ColumnSpacing="8">

            <Button
                Grid.Column="0"
                Text="Parents" />

            <Button
                Grid.Column="1"
                Text="Teachers" />

            <Button
                Grid.Column="2"
                Text="Learners" />

        </Grid>

        <!-- USERS -->
        <CollectionView Grid.Row="3" ItemsSource="{Binding Users}">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        Padding="15"
                        Margin="0,5"
                        Stroke="#DDDDDD"
                        StrokeShape="RoundRectangle 10">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout>
                                <Label
                                    Text="{Binding FullName}"
                                    FontSize="16"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding Role}"
                                    FontSize="13"
                                    TextColor="Gray" />
                            </VerticalStackLayout>

                            <Label
                                Grid.Column="1"
                                Text="›"
                                FontSize="25"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>