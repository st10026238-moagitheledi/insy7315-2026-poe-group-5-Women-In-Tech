<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:KoosMatliApp.Resources.Localization"
             x:Class="KoosMatliApp.Pages.ResetPassword"
             BackgroundColor="#FFFFFF">
    <ScrollView>
        <StackLayout Padding="24" Spacing="12">
            <VerticalStackLayout Padding="24" Spacing="22" MaximumWidthRequest="400">

                <Image Source="lock.png" WidthRequest="96" HeightRequest="96" HorizontalOptions="Center" />
                <Label x:Name="ResetLabel" Text="{x:Static loc:AppResources.TitleResetPassword}" FontSize="20" HorizontalOptions="Center" FontAttributes="Bold" TextColor="#173665" />
                <Label Text="{x:Static loc:AppResources.DescResetPassword}" FontSize="14" TextColor="#666" HorizontalTextAlignment="Center" />

                <Border Stroke="#CCCCCC" StrokeShape="RoundRectangle 8" Padding="12,4" Margin="0,10,0,0">
                    <Grid ColumnDefinitions="*, Auto">
                        <Entry x:Name="NewPasswordEntry" IsPassword="True" Placeholder="{x:Static loc:AppResources.PhNewPassword}" PlaceholderColor="#A3A3A3" TextColor="#173665" FontSize="15" HeightRequest="44" />
                        <ImageButton x:Name="ToggleNewPasswordButton" Source="ic_eye_hide.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" Grid.Column="1" Clicked="ToggleNewPassword_Clicked" BackgroundColor="Transparent" />
                    </Grid>
                </Border>

                <Border Stroke="#CCCCCC" StrokeShape="RoundRectangle 8" Padding="12,4">
                    <Grid ColumnDefinitions="*, Auto">
                        <Entry x:Name="ConfirmPasswordEntry" IsPassword="True" Placeholder="{x:Static loc:AppResources.PhConfirmPassword}" PlaceholderColor="#A3A3A3" TextColor="#173665" FontSize="15" HeightRequest="44" />
                        <ImageButton x:Name="ToggleConfirmPasswordButton" Source="ic_eye_hide.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" Grid.Column="1" Clicked="ToggleConfirmPassword_Clicked" BackgroundColor="Transparent" />
                    </Grid>
                </Border>

                <Button Text="{x:Static loc:AppResources.BtnResetPassword}" BackgroundColor="#173665" TextColor="White" Clicked="Reset_Clicked" />
            </VerticalStackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>
