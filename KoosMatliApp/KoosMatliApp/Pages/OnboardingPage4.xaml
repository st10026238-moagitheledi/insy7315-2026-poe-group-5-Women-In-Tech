<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:KoosMatliApp.Resources.Localization"
             x:Class="KoosMatliApp.Pages.OnboardingPage4"
             BackgroundColor="#FFFFFF"
             NavigationPage.HasNavigationBar="False"
>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="24" RowDefinitions="Auto, *, Auto">

            <!-- ROW 0: Fixed Quick Language Switcher Bar -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                <HorizontalStackLayout Grid.Column="0" Spacing="12" VerticalOptions="Center">
                    <Button Text="EN" TextColor="#173665" FontSize="13" FontAttributes="Bold" BackgroundColor="Transparent" Padding="0" Clicked="ChangeLanguage_Clicked" CommandParameter="en" />
                    <Label Text="|" TextColor="#CCCCCC" VerticalOptions="Center"/>
                    <Button Text="NSO" TextColor="#173665" FontSize="13" FontAttributes="Bold" BackgroundColor="Transparent" Padding="0" Clicked="ChangeLanguage_Clicked" CommandParameter="nso-ZA" />
                    <Label Text="|" TextColor="#CCCCCC" VerticalOptions="Center"/>
                    <Button Text="TSN" TextColor="#173665" FontSize="13" FontAttributes="Bold" BackgroundColor="Transparent" Padding="0" Clicked="ChangeLanguage_Clicked" CommandParameter="tn-ZA" />
                </HorizontalStackLayout>
            </Grid>
        </Grid>

        <!-- Logo top -->
        <Image Source="logo.png" WidthRequest="96" HeightRequest="96" HorizontalOptions="Center" />

        <!-- Content -->
        <StackLayout Grid.Row="1" Spacing="18" VerticalOptions="Center" HorizontalOptions="CenterAndExpand">
            <Frame x:Name="OnboardFrame" WidthRequest="220" HeightRequest="220" CornerRadius="110" BackgroundColor="#FFE9C9" HasShadow="False" Padding="24" HorizontalOptions="Center">
                <Image x:Name="OnboardImage" Source="graph.png" Aspect="AspectFit" />
            </Frame>

            <Label Text="{x:Static loc:AppResources.TitleDataSaver}" FontSize="20" TextColor="#173665" HorizontalOptions="Center" FontAttributes="Bold" HorizontalTextAlignment="Center" />
            <Label Text="{x:Static loc:AppResources.DescDataSaver}" FontSize="14" TextColor="#666666" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
        </StackLayout>

        <!-- Get Started button -->
        <Button Grid.Row="2" Text="{x:Static loc:AppResources.BtnGetStarted}" HorizontalOptions="Fill" BackgroundColor="#173665" TextColor="White" CornerRadius="10" Clicked="GetStarted_Clicked" />

    </Grid>
</ContentPage>
    
