<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:KoosMatliApp.Resources.Localization"
             x:Class="KoosMatliApp.Pages.VerifyPage"
             BackgroundColor="#FFFFFF">

    <StackLayout Padding="24" Spacing="12" VerticalOptions="Center">
        <Image Source="lock.png" WidthRequest="96" HeightRequest="96" HorizontalOptions="Center" />
        <Label Text="{x:Static loc:AppResources.TitleVerifyCode}" FontSize="20" HorizontalOptions="Center" FontAttributes="Bold" TextColor="#173665" />
        <Label Text="{x:Static loc:AppResources.DescVerifyCode}" FontSize="14" TextColor="#666" HorizontalTextAlignment="Center" />

        <Grid ColumnDefinitions="*,*,*,*,*,*" HorizontalOptions="Center" ColumnSpacing="8" Margin="0,10">
            <Border Grid.Column="0" Stroke="#CCCCCC" StrokeShape="RoundRectangle 8" HeightRequest="50" WidthRequest="44">
                <Entry x:Name="D0" MaxLength="1" Keyboard="Numeric" HorizontalTextAlignment="Center" FontSize="18" TextColor="#173665" BackgroundColor="Transparent" />
            </Border>
            <Border Grid.Column="1" Stroke="#CCCCCC" StrokeShape="RoundRectangle 8" HeightRequest="50" WidthRequest="44">
                <Entry x:Name="D1" MaxLength="1" Keyboard="Numeric" HorizontalTextAlignment="Center" FontSize="18" TextColor="#173665" BackgroundColor="Transparent" />
            </Border>
            <Border Grid.Column="2" Stroke="#CCCCCC" StrokeShape="RoundRectangle 8" HeightRequest="50" WidthRequest="44">
                <Entry x:Name="D2" MaxLength="1" Keyboard="Numeric" HorizontalTextAlignment="Center" FontSize="18" TextColor="#173665" BackgroundColor="Transparent" />
            </Border>
            <Border Grid.Column="3" Stroke="#CCCCCC" StrokeShape="RoundRectangle 8" HeightRequest="50" WidthRequest="44">
                <Entry x:Name="D3" MaxLength="1" Keyboard="Numeric" HorizontalTextAlignment="Center" FontSize="18" TextColor="#173665" BackgroundColor="Transparent" />
            </Border>
            <Border Grid.Column="4" Stroke="#CCCCCC" StrokeShape="RoundRectangle 8" HeightRequest="50" WidthRequest="44">
                <Entry x:Name="D4" MaxLength="1" Keyboard="Numeric" HorizontalTextAlignment="Center" FontSize="18" TextColor="#173665" BackgroundColor="Transparent" />
            </Border>
            <Border Grid.Column="5" Stroke="#CCCCCC" StrokeShape="RoundRectangle 8" HeightRequest="50" WidthRequest="44">
                <Entry x:Name="D5" MaxLength="1" Keyboard="Numeric" HorizontalTextAlignment="Center" FontSize="18" TextColor="#173665" BackgroundColor="Transparent" />
            </Border>
        </Grid>

        <Button Text="{x:Static loc:AppResources.BtnVerify}" BackgroundColor="#173665" TextColor="White" Clicked="Verify_Clicked" />
        
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,10,0,0">
            <Label Text="{x:Static loc:AppResources.LblDidNotReceive}" TextColor="#555555" FontSize="14" VerticalOptions="Center" />
            <Button Text="{x:Static loc:AppResources.BtnResendCode}" TextColor="#2A62B5" FontAttributes="Bold" FontSize="14" BackgroundColor="Transparent" Padding="0" HeightRequest="30" Clicked="Resend_Clicked" />
        </HorizontalStackLayout>
    </StackLayout>
</ContentPage>
