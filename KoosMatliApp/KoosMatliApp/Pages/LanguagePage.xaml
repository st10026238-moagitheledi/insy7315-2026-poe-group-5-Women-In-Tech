<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KoosMatliApp.Pages.LanguagePage"
             BackgroundColor="#FFFFFF">

    <StackLayout Padding="24" Spacing="20" VerticalOptions="Center">
        <Image Source="logo.png" WidthRequest="96" HeightRequest="96" HorizontalOptions="Center" />

        <Frame WidthRequest="220" HeightRequest="220" CornerRadius="110" BackgroundColor="#FFE9C9" HasShadow="False" Padding="24" HorizontalOptions="Center">
            <Image Source="language.png" Aspect="AspectFit" />
        </Frame>

        <Label Text="CHOOSE YOUR LANGUAGE" FontSize="14" TextColor="#173665" HorizontalOptions="Center" />

        <Button Text="English" BackgroundColor="#173665" TextColor="White" CornerRadius="8" Clicked="LanguageSelected" />
        <Button Text="Sepedi" BackgroundColor="#173665" TextColor="White" CornerRadius="8" Clicked="LanguageSelected" />
        <Button Text="Setswana" BackgroundColor="#173665" TextColor="White" CornerRadius="8" Clicked="LanguageSelected" />

    </StackLayout>
</ContentPage>
