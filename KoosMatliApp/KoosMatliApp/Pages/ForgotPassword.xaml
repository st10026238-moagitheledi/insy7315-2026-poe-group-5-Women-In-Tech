<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:KoosMatliApp.Resources.Localization"
             x:Class="KoosMatliApp.Pages.ForgotPassword"
             BackgroundColor="#FFFFFF">
    <ScrollView>
        <StackLayout Padding="24" Spacing="12">
            <Image Source="lock.png" WidthRequest="96" HeightRequest="96" HorizontalOptions="Center" />
            <Label x:Name="ForgotLabel" Text="{x:Static loc:AppResources.TitleForgotPassword}" FontSize="20" HorizontalOptions="Center" FontAttributes="Bold" TextColor="#173665" />
            <Label Text="{x:Static loc:AppResources.DescForgotPassword}" FontSize="14" TextColor="#666" HorizontalTextAlignment="Center" />

            <Entry x:Name="ForgotEmailEntry" Placeholder="{x:Static loc:AppResources.PhEmailAddress}" Keyboard="Email" />
            <Button Text="{x:Static loc:AppResources.BtnSendCode}" BackgroundColor="#173665" TextColor="White" Clicked="SendCode_Clicked" />
            <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
                <Label Text="{x:Static loc:AppResources.LblRememberPassword}" TextColor="#555555" FontSize="14" VerticalOptions="Center" />
                <Button Text="{x:Static loc:AppResources.BtnLogIn}" TextColor="#173665" FontAttributes="Bold" FontSize="14" BackgroundColor="Transparent" Padding="0" HeightRequest="30" Clicked="BackToLogin_Clicked" />
            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>
