<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns:vm="clr-namespace:KoosMatliApp.ViewModels" xmlns:model="clr-namespace:KoosMatliApp.Models" x:DataType="vm:AdminDashboardViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KoosMatliApp.Views.Admin.AdminDashboardPage"
    Title="{DynamicResource T_67B696468610}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- HEADER -->
            <VerticalStackLayout Spacing="4">
                <Label
                    Text="{Binding Title}"
                    FontSize="28"
                    FontAttributes="Bold" />

                <Label
                    Text="Koos Matli Primary School"
                    FontSize="15"
                    TextColor="Gray" />
            </VerticalStackLayout>

            <Label Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding HasError}"/>
            <ActivityIndicator IsRunning="{Binding IsBusy}"/>
            <!-- SCHOOL OVERVIEW -->
            <Label
                Text="{DynamicResource T_B7D5E8DEF7AF}"
                FontSize="20"
                FontAttributes="Bold" />

            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto,Auto,*,Auto"
                ColumnSpacing="12"
                RowSpacing="12">

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="20"
                    Stroke="#DDDDDD"
                    StrokeShape="RoundRectangle 12">

                    <VerticalStackLayout>
                        <Label
                            Text="{Binding Dashboard.TotalLearners}"
                            FontSize="26"
                            FontAttributes="Bold"
                            HorizontalOptions="Center" />

                        <Label
                            Text="{DynamicResource T_B8B5AE579B24}"
                            HorizontalOptions="Center" />
                    </VerticalStackLayout>

                </Border>

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="20"
                    Stroke="#DDDDDD"
                    StrokeShape="RoundRectangle 12">

                    <VerticalStackLayout>
                        <Label
                            Text="{Binding Dashboard.TotalTeachers}"
                            FontSize="26"
                            FontAttributes="Bold"
                            HorizontalOptions="Center" />

                        <Label
                            Text="{DynamicResource T_33C512C6EEC1}"
                            HorizontalOptions="Center" />
                    </VerticalStackLayout>

                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Padding="20"
                    Stroke="#DDDDDD"
                    StrokeShape="RoundRectangle 12">

                    <VerticalStackLayout>
                        <Label
                            Text="{Binding Dashboard.TotalParents}"
                            FontSize="26"
                            FontAttributes="Bold"
                            HorizontalOptions="Center" />

                        <Label
                            Text="{DynamicResource T_C8B2999ED42D}"
                            HorizontalOptions="Center" />
                    </VerticalStackLayout>

                </Border>

            </Grid>

            <!-- TODAY'S SUMMARY -->
            <Label
                Text="{DynamicResource T_8ED120159ECA}"
                FontSize="20"
                FontAttributes="Bold" />

            <Border
                Padding="18"
                Stroke="#DDDDDD"
                StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{DynamicResource T_6E2BE99CC54C}" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding Dashboard.NewApplications}"
                            FontAttributes="Bold" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{DynamicResource T_B5B56177F25C}" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding Dashboard.PendingApplications}"
                            FontAttributes="Bold" />
                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!-- QUICK ACTIONS -->
            <Label
                Text="{DynamicResource T_2CC2B6F7F200}"
                FontSize="20"
                FontAttributes="Bold" />

            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto,Auto,*,Auto"
                ColumnSpacing="10"
                RowSpacing="10">

                <Button
                    x:Name="btnSchoolDetails"
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="{DynamicResource T_13AFEF346B27}"
                    HeightRequest="60" />

                <Button
                    x:Name="btnSchoolDates"
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{DynamicResource T_87EF078ACE17}"
                    HeightRequest="60" />

                <Button
                    x:Name="btnSchoolCalendar"
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="{DynamicResource T_2A31515574F6}"
                    HeightRequest="60" />

                <Button
                    x:Name="btnDocuments"
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{DynamicResource T_B4E929D8BCFE}"
                    HeightRequest="60" />

            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>