<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KoosMatliApp.Views.Authentication.ForgotPasswordPage"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F5F7FC">

    <ScrollView>
        <VerticalStackLayout Padding="25,35,25,30"
                             Spacing="24">

            <!-- School branding -->
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="12">

                <Border Grid.Column="0"
                        WidthRequest="55"
                        HeightRequest="55"
                        BackgroundColor="#061D45"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14">

                    <Label Text="KM"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#FFBF19"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="3"
                                     VerticalOptions="Center">

                    <Label Text="KOOS MATLI"
                           FontSize="19"
                           FontAttributes="Bold"
                           TextColor="#061D45" />

                    <Label Text="PRIMARY SCHOOL"
                           FontSize="11"
                           CharacterSpacing="2"
                           TextColor="#B8860B" />

                    <Label Text="Thuto ke Lesedi • Education is Light"
                           FontSize="10"
                           TextColor="#64748B" />
                </VerticalStackLayout>
            </Grid>

            <!-- Illustration -->
            <Border HeightRequest="150"
                    BackgroundColor="#E8EEF9"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24"
                    Margin="0,15,0,0">

                <VerticalStackLayout Spacing="8"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">

                    <Label Text="✉"
                           FontSize="48"
                           TextColor="#1239C9"
                           HorizontalOptions="Center" />

                    <Label Text="Account Recovery"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#061D45"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Instructions -->
            <VerticalStackLayout Spacing="10">

                <Label Text="Forgot your password?"
                       FontSize="27"
                       FontAttributes="Bold"
                       TextColor="#061D45" />

                <Label Text="It happens! Enter the email address associated with your account and we'll help you reset your password."
                       FontSize="14"
                       TextColor="#64748B"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <!-- Form -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="20">

                <VerticalStackLayout Spacing="16">

                    <Label Text="Email Address"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#061D45" />

                    <Entry x:Name="EmailEntry"
                           Placeholder="Enter your registered email"
                           Keyboard="Email"
                           TextColor="#0F172A"
                           PlaceholderColor="#94A3B8"
                           BackgroundColor="#F8FAFC"
                           ClearButtonVisibility="WhileEditing" />

                    <Label x:Name="StatusLabel"
                           IsVisible="False"
                           FontSize="12"
                           TextColor="#B91C1C"
                           LineBreakMode="WordWrap" />

                    <Button x:Name="ResetButton"
                            Text="Send Reset Instructions"
                            Clicked="OnResetClicked"
                            BackgroundColor="#061D45"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="14"
                            HeightRequest="52"
                            CornerRadius="12" />

                    <ActivityIndicator x:Name="ResetActivityIndicator"
                                       IsVisible="False"
                                       IsRunning="False"
                                       Color="#1239C9"
                                       HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Border>

            <!-- Back to login -->
            <Button Text="← Back to Sign In"
                    Clicked="OnBackToLoginClicked"
                    BackgroundColor="Transparent"
                    TextColor="#1239C9"
                    FontAttributes="Bold"
                    HorizontalOptions="Center" />

            <Label Text="Keep your account secure. Never share your password or reset link with anyone."
                   FontSize="11"
                   TextColor="#64748B"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
