<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KoosMatliApp.Views.Parent.SchoolCalendarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="School Calendar"
    BackgroundColor="#F5F7FB">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0"
              BackgroundColor="#172554"
              Padding="22,25,22,22"
              RowDefinitions="Auto,Auto"
              RowSpacing="6">

            <Label Grid.Row="0"
                   Text="PARENT PORTAL"
                   FontSize="11"
                   FontAttributes="Bold"
                   TextColor="#93C5FD"
                   CharacterSpacing="2" />

            <Label Grid.Row="1"
                   Text="School Calendar &amp; Events"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White" />
        </Grid>

        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20"
                                 Spacing="18">

                <VerticalStackLayout Spacing="4">
                    <Label Text="What's Happening?"
                           FontSize="21"
                           FontAttributes="Bold"
                           TextColor="#172554" />

                    <Label Text="Keep track of school dates, activities and important events."
                           FontSize="13"
                           TextColor="#64748B" />
                </VerticalStackLayout>

                <!-- Month Selector -->
                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        Padding="14"
                        StrokeShape="RoundRectangle 14">

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="12">

                        <Button Grid.Column="0"
                                Text="‹"
                                FontSize="25"
                                TextColor="#243B80"
                                BackgroundColor="#EEF2FF"
                                CornerRadius="12"
                                WidthRequest="44"
                                HeightRequest="44"
                                Padding="0"
                                Clicked="OnPreviousMonthClicked" />

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="3"
                                             VerticalOptions="Center"
                                             HorizontalOptions="Center">
                            <Label x:Name="MonthLabel"
                                   Text="October 2026"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#172554"
                                   HorizontalTextAlignment="Center" />

                            <Label Text="SCHOOL CALENDAR"
                                   FontSize="10"
                                   CharacterSpacing="1"
                                   TextColor="#94A3B8"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <Button Grid.Column="2"
                                Text="›"
                                FontSize="25"
                                TextColor="#243B80"
                                BackgroundColor="#EEF2FF"
                                CornerRadius="12"
                                WidthRequest="44"
                                HeightRequest="44"
                                Padding="0"
                                Clicked="OnNextMonthClicked" />
                    </Grid>
                </Border>

                <!-- Calendar -->
                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        Padding="12"
                        StrokeShape="RoundRectangle 14">

                    <VerticalStackLayout Spacing="10">

                        <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                            <Label Grid.Column="0" Text="S" FontAttributes="Bold" FontSize="12" TextColor="#94A3B8" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="M" FontAttributes="Bold" FontSize="12" TextColor="#94A3B8" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="2" Text="T" FontAttributes="Bold" FontSize="12" TextColor="#94A3B8" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="3" Text="W" FontAttributes="Bold" FontSize="12" TextColor="#94A3B8" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="4" Text="T" FontAttributes="Bold" FontSize="12" TextColor="#94A3B8" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="5" Text="F" FontAttributes="Bold" FontSize="12" TextColor="#94A3B8" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="6" Text="S" FontAttributes="Bold" FontSize="12" TextColor="#94A3B8" HorizontalTextAlignment="Center" />
                        </Grid>

                        <Grid x:Name="CalendarDaysGrid"
                              RowDefinitions="44,44,44,44,44,44"
                              ColumnDefinitions="*,*,*,*,*,*,*"
                              RowSpacing="4"
                              ColumnSpacing="2" />
                    </VerticalStackLayout>
                </Border>

                <!-- Legend -->
                <HorizontalStackLayout Spacing="16"
                                       HorizontalOptions="Center">
                    <HorizontalStackLayout Spacing="5">
                        <BoxView Color="#4338CA"
                                 WidthRequest="8"
                                 HeightRequest="8"
                                 CornerRadius="4"
                                 VerticalOptions="Center" />
                        <Label Text="School event"
                               FontSize="11"
                               TextColor="#64748B"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="5">
                        <BoxView Color="#F59E0B"
                                 WidthRequest="8"
                                 HeightRequest="8"
                                 CornerRadius="4"
                                 VerticalOptions="Center" />
                        <Label Text="Important date"
                               FontSize="11"
                               TextColor="#64748B"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </HorizontalStackLayout>

                <!-- Selected Date -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label x:Name="SelectedDateLabel"
                           Text="Upcoming Events"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#172554"
                           VerticalOptions="Center" />

                    <Label x:Name="EventCountLabel"
                           Grid.Column="1"
                           Text="0 events"
                           FontSize="12"
                           TextColor="#64748B"
                           VerticalOptions="Center" />
                </Grid>

                <ActivityIndicator x:Name="LoadingIndicator"
                                   IsVisible="False"
                                   IsRunning="False"
                                   Color="#4338CA"
                                   HorizontalOptions="Center" />

                <Border x:Name="StatusContainer"
                        IsVisible="False"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        Padding="16"
                        StrokeShape="RoundRectangle 14">
                    <Label x:Name="StatusLabel"
                           Text=""
                           FontSize="13"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center" />
                </Border>

                <!-- Event List -->
                <CollectionView x:Name="EventsCollectionView"
                                ItemsSource="{Binding FilteredEvents}"
                                SelectionMode="None">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20"
                                             Spacing="8"
                                             HorizontalOptions="Center">
                            <Label Text="No events for this date"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#334155"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Select another date or month to explore the calendar."
                                   FontSize="13"
                                   TextColor="#64748B"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    Padding="14"
                                    Margin="0,0,0,12"
                                    StrokeShape="RoundRectangle 14">

                                <Grid ColumnDefinitions="58,*"
                                      ColumnSpacing="14">

                                    <Border Grid.Column="0"
                                            BackgroundColor="#EEF2FF"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="5"
                                            VerticalOptions="Start">

                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding DayNumber}"
                                                   FontSize="23"
                                                   FontAttributes="Bold"
                                                   TextColor="#243B80"
                                                   HorizontalTextAlignment="Center" />

                                            <Label Text="{Binding MonthShort}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="#4338CA"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="6">

                                        <Label Text="{Binding Title}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="#172554" />

                                        <Label Text="{Binding Description}"
                                               FontSize="12"
                                               TextColor="#64748B"
                                               LineBreakMode="WordWrap"
                                               MaxLines="3" />

                                        <Label Text="{Binding TimeDisplay}"
                                               FontSize="11"
                                               TextColor="#4338CA" />

                                        <Label Text="{Binding LocationDisplay}"
                                               FontSize="11"
                                               TextColor="#94A3B8" />

                                        <Border BackgroundColor="#FFF7ED"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="8,4"
                                                HorizontalOptions="Start">
                                            <Label Text="{Binding Category}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="#C2410C" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Navigation -->
        <Grid Grid.Row="2"
              BackgroundColor="White"
              Padding="6,10"
              ColumnDefinitions="*,*,*,*,*">

            <VerticalStackLayout Grid.Column="0"
                                 Spacing="4"
                                 HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="⌂" FontSize="23" TextColor="#94A3B8" HorizontalTextAlignment="Center" />
                <Label Text="Home" FontSize="10" TextColor="#94A3B8" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="4"
                                 HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnScheduleTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="▦" FontSize="21" TextColor="#94A3B8" HorizontalTextAlignment="Center" />
                <Label Text="Timetable" FontSize="10" TextColor="#94A3B8" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="2"
                                 Spacing="4"
                                 HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnUpdatesTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="◉" FontSize="22" TextColor="#94A3B8" HorizontalTextAlignment="Center" />
                <Label Text="Updates" FontSize="10" TextColor="#94A3B8" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="3"
                                 Spacing="4"
                                 HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnChildrenTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="♧" FontSize="22" TextColor="#94A3B8" HorizontalTextAlignment="Center" />
                <Label Text="Children" FontSize="10" TextColor="#94A3B8" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="4"
                                 Spacing="4"
                                 HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="◎" FontSize="22" TextColor="#94A3B8" HorizontalTextAlignment="Center" />
                <Label Text="Profile" FontSize="10" TextColor="#94A3B8" />
            </VerticalStackLayout>

        </Grid>
    </Grid>
</ContentPage>
