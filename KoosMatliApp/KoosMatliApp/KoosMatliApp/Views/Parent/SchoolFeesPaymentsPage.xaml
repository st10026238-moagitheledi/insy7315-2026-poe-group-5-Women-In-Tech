<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KoosMatliApp.Views.Parent.SchoolFeesPaymentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="School Fees"
    BackgroundColor="#F5F7FB"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0"
              BackgroundColor="#172554"
              Padding="22,18,22,22"
              RowDefinitions="Auto,Auto">

            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="4">
                    <Label Text="KOOS MATLI SCHOOL"
                           FontSize="11"
                           CharacterSpacing="1.5"
                           TextColor="#BFDBFE"
                           FontAttributes="Bold" />
                    <Label Text="School Fees &amp; Payments"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>

                <Border Grid.Column="1"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeThickness="0"
                        BackgroundColor="#263B70"
                        StrokeShape="RoundRectangle 14"
                        VerticalOptions="Start">
                    <Label Text="R"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </Grid>

            <Label Grid.Row="1"
                   Text="Manage balances, invoices and payment records."
                   FontSize="13"
                   TextColor="#DCE6FF"
                   Margin="0,12,0,0" />
        </Grid>

        <!-- Main content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,18,18,24"
                                 Spacing="18">

                <Label Text="Select learner"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#172554" />

                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="12,4">
                    <Picker x:Name="LearnerPicker"
                            Title="Choose a learner"
                            TextColor="#172554"
                            TitleColor="#64748B"
                            SelectedIndexChanged="OnLearnerChanged" />
                </Border>

                <!-- Balance card -->
                <Border BackgroundColor="#243B80"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        Padding="20">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="OUTSTANDING BALANCE"
                               FontSize="12"
                               CharacterSpacing="1"
                               FontAttributes="Bold"
                               TextColor="#DCE6FF" />

                        <Label x:Name="BalanceLabel"
                               Text="R 4,500.00"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="White" />

                        <Label x:Name="BalanceDescription"
                               Text="Sample balance · Please verify with the school"
                               FontSize="12"
                               TextColor="#DCE6FF" />

                        <BoxView HeightRequest="1"
                                 Color="#536AA8"
                                 Margin="0,4" />

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Next due date"
                                       FontSize="12"
                                       TextColor="#DCE6FF" />
                                <Label x:Name="DueDateLabel"
                                       Text="30 October 2026"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4">
                                <Label Text="Payment status"
                                       FontSize="12"
                                       TextColor="#DCE6FF" />
                                <Label x:Name="PaymentStatusLabel"
                                       Text="Payment due"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#FDE68A" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Summary -->
                <Label Text="Fee summary"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#172554" />

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">

                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="15">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Total fees"
                                   FontSize="12"
                                   TextColor="#64748B" />
                            <Label x:Name="TotalFeesLabel"
                                   Text="R 18,000"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#172554" />
                            <Label Text="For this school year"
                                   FontSize="11"
                                   TextColor="#64748B" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="15">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Paid to date"
                                   FontSize="12"
                                   TextColor="#64748B" />
                            <Label x:Name="PaidFeesLabel"
                                   Text="R 13,500"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#15803D" />
                            <Label Text="Recorded payments"
                                   FontSize="11"
                                   TextColor="#64748B" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Fee statement -->
                <Grid ColumnDefinitions="*,Auto"
                      VerticalOptions="Center">
                    <Label Text="Fee statement"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#172554"
                           VerticalOptions="Center" />

                    <Label Text="2026"
                           Grid.Column="1"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#64748B"
                           VerticalOptions="Center" />
                </Grid>

                <VerticalStackLayout x:Name="FeeItemsContainer"
                                     Spacing="12" />

                <!-- Payment guidance -->
                <Border BackgroundColor="#EFF6FF"
                        Stroke="#BFDBFE"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="15">
                    <HorizontalStackLayout Spacing="12"
                                           VerticalOptions="Center">
                        <Label Text="ⓘ"
                               FontSize="22"
                               TextColor="#1D4ED8"
                               VerticalOptions="Start" />
                        <VerticalStackLayout Spacing="5"
                                             HorizontalOptions="FillAndExpand">
                            <Label Text="Need help with your account?"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#1E3A8A" />
                            <Label Text="Contact the school finance office to confirm balances, payment methods or missing receipts."
                                   FontSize="12"
                                   TextColor="#1E40AF" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom navigation -->
        <Grid Grid.Row="2"
              BackgroundColor="White"
              Padding="4,8"
              ColumnDefinitions="*,*,*,*,*"
              ColumnSpacing="0">

            <VerticalStackLayout Grid.Column="0"
                                 Spacing="3"
                                 HorizontalOptions="Center">
                <Label Text="⌂"
                       FontSize="23"
                       TextColor="#64748B"
                       HorizontalOptions="Center" />
                <Label Text="Home"
                       FontSize="10"
                       TextColor="#64748B" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeTapped" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="3"
                                 HorizontalOptions="Center">
                <Label Text="▦"
                       FontSize="22"
                       TextColor="#64748B"
                       HorizontalOptions="Center" />
                <Label Text="Timetable"
                       FontSize="10"
                       TextColor="#64748B" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTimetableTapped" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="2"
                                 Spacing="3"
                                 HorizontalOptions="Center">
                <Label Text="◉"
                       FontSize="22"
                       TextColor="#64748B"
                       HorizontalOptions="Center" />
                <Label Text="Updates"
                       FontSize="10"
                       TextColor="#64748B" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnUpdatesTapped" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="3"
                                 Spacing="3"
                                 HorizontalOptions="Center">
                <Label Text="♧"
                       FontSize="22"
                       TextColor="#64748B"
                       HorizontalOptions="Center" />
                <Label Text="Children"
                       FontSize="10"
                       TextColor="#64748B" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnChildrenTapped" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="4"
                                 Spacing="3"
                                 HorizontalOptions="Center">
                <Label Text="○"
                       FontSize="22"
                       TextColor="#64748B"
                       HorizontalOptions="Center" />
                <Label Text="Profile"
                       FontSize="10"
                       TextColor="#64748B" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileTapped" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
