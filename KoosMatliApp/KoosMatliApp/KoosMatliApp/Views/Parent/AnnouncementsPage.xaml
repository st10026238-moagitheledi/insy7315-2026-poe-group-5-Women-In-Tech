<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KoosMatliApp.Views.Parent.AnnouncementsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Announcements"
    BackgroundColor="#F5F7FB">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0"
              BackgroundColor="#172554"
              Padding="22,25,22,22"
              RowDefinitions="Auto,Auto"
              RowSpacing="6">

            <Label Grid.Row="0"
                   Text="PARENT PORTAL"
                   FontSize="11"
                   FontAttributes="Bold"
                   TextColor="#93C5FD"
                   CharacterSpacing="2" />

            <Label Grid.Row="1"
                   Text="Announcements"
                   FontSize="27"
                   FontAttributes="Bold"
                   TextColor="White" />

        </Grid>

        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20"
                                 Spacing="18">

                <VerticalStackLayout Spacing="4">
                    <Label Text="School Updates"
                           FontSize="21"
                           FontAttributes="Bold"
                           TextColor="#172554" />

                    <Label Text="Stay informed about important school news and notices."
                           FontSize="13"
                           TextColor="#64748B" />
                </VerticalStackLayout>

                <!-- Search -->
                <SearchBar
                    x:Name="AnnouncementSearchBar"
                    Placeholder="Search announcements..."
                    BackgroundColor="White"
                    TextColor="#1E293B"
                    PlaceholderColor="#94A3B8"
                    CancelButtonColor="#172554"
                    TextChanged="OnSearchTextChanged" />

                <!-- Category Filter -->
                <ScrollView Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8">

                        <Button x:Name="AllButton"
                                Text="All"
                                Clicked="OnCategoryClicked"
                                CommandParameter="All"
                                BackgroundColor="#243B80"
                                TextColor="White"
                                CornerRadius="18"
                                Padding="18,8"
                                FontSize="12" />

                        <Button x:Name="AcademicButton"
                                Text="Academic"
                                Clicked="OnCategoryClicked"
                                CommandParameter="Academic"
                                BackgroundColor="White"
                                TextColor="#334155"
                                CornerRadius="18"
                                Padding="18,8"
                                FontSize="12" />

                        <Button x:Name="EventsButton"
                                Text="Events"
                                Clicked="OnCategoryClicked"
                                CommandParameter="Events"
                                BackgroundColor="White"
                                TextColor="#334155"
                                CornerRadius="18"
                                Padding="18,8"
                                FontSize="12" />

                        <Button x:Name="GeneralButton"
                                Text="General"
                                Clicked="OnCategoryClicked"
                                CommandParameter="General"
                                BackgroundColor="White"
                                TextColor="#334155"
                                CornerRadius="18"
                                Padding="18,8"
                                FontSize="12" />

                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Loading -->
                <ActivityIndicator
                    x:Name="LoadingIndicator"
                    IsVisible="False"
                    IsRunning="False"
                    Color="#4338CA"
                    HorizontalOptions="Center" />

                <!-- Status Message -->
                <Border x:Name="StatusContainer"
                        IsVisible="False"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        Padding="18"
                        StrokeShape="RoundRectangle 14">

                    <Label x:Name="StatusLabel"
                           Text=""
                           FontSize="13"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center" />
                </Border>

                <!-- Announcement Count -->
                <Label x:Name="AnnouncementCountLabel"
                       Text="Announcements"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#64748B" />

                <!-- Announcements List -->
                <CollectionView
                    x:Name="AnnouncementsCollectionView"
                    ItemsSource="{Binding FilteredAnnouncements}"
                    SelectionMode="None">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20"
                                             Spacing="8"
                                             HorizontalOptions="Center">

                            <Label Text="No announcements found"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#334155"
                                   HorizontalTextAlignment="Center" />

                            <Label Text="Try another search or category."
                                   FontSize="13"
                                   TextColor="#64748B"
                                   HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    Padding="16"
                                    Margin="0,0,0,12"
                                    StrokeShape="RoundRectangle 16">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnAnnouncementTapped"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="11">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <Border Grid.Column="0"
                                                BackgroundColor="#EEF2FF"
                                                Padding="10,5"
                                                HorizontalOptions="Start"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 10">

                                            <Label Text="{Binding Category}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="#4338CA" />
                                        </Border>

                                        <Label Grid.Column="1"
                                               Text="{Binding DateDisplay}"
                                               FontSize="11"
                                               TextColor="#94A3B8"
                                               VerticalOptions="Center"
                                               HorizontalTextAlignment="End" />
                                    </Grid>

                                    <Label Text="{Binding Title}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#172554" />

                                    <Label Text="{Binding Summary}"
                                           FontSize="13"
                                           TextColor="#64748B"
                                           LineBreakMode="WordWrap"
                                           MaxLines="3" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding AuthorDisplay}"
                                               FontSize="11"
                                               TextColor="#94A3B8"
                                               VerticalOptions="Center" />

                                        <Label Grid.Column="1"
                                               Text="Read more →"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="#4338CA"
                                               VerticalOptions="Center" />
                                    </Grid>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Navigation -->
        <Grid Grid.Row="2"
              BackgroundColor="White"
              Padding="6,10"
              ColumnDefinitions="*,*,*,*,*">

            <VerticalStackLayout Grid.Column="0"
                                 Spacing="4"
                                 HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="⌂"
                       FontSize="23"
                       TextColor="#94A3B8"
                       HorizontalTextAlignment="Center" />
                <Label Text="Home"
                       FontSize="10"
                       TextColor="#94A3B8" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="4"
                                 HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnScheduleTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="▦"
                       FontSize="21"
                       TextColor="#94A3B8"
                       HorizontalTextAlignment="Center" />
                <Label Text="Timetable"
                       FontSize="10"
                       TextColor="#94A3B8" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="2"
                                 Spacing="4"
                                 HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnUpdatesTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="◉"
                       FontSize="22"
                       TextColor="#4338CA"
                       HorizontalTextAlignment="Center" />
                <Label Text="Updates"
                       FontSize="10"
                       FontAttributes="Bold"
                       TextColor="#4338CA" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="3"
                                 Spacing="4"
                                 HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnChildrenTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="♧"
                       FontSize="22"
                       TextColor="#94A3B8"
                       HorizontalTextAlignment="Center" />
                <Label Text="Children"
                       FontSize="10"
                       TextColor="#94A3B8" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="4"
                                 Spacing="4"
                                 HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="◎"
                       FontSize="22"
                       TextColor="#94A3B8"
                       HorizontalTextAlignment="Center" />
                <Label Text="Profile"
                       FontSize="10"
                       TextColor="#94A3B8" />
            </VerticalStackLayout>

        </Grid>

    </Grid>
</ContentPage>