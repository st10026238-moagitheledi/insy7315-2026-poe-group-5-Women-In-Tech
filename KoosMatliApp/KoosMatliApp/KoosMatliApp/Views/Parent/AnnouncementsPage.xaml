<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KoosMatliApp.Views.Parent.AnnouncementsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F5F7FC">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- NAVY SCHOOL HEADER -->
        <Grid
            Grid.Row="0"
            BackgroundColor="#061D45"
            Padding="20,18,20,22"
            ColumnDefinitions="*,Auto">

            <VerticalStackLayout Spacing="5">
                <Label
                    Text="KOOS MATLI PRIMARY SCHOOL"
                    FontSize="10"
                    CharacterSpacing="1.2"
                    FontAttributes="Bold"
                    TextColor="#FFBF19" />

                <Label
                    Text="Announcements"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="White" />

                <Label
                    Text="Stay informed about school news and important updates."
                    FontSize="12"
                    TextColor="#D7E2F4" />
            </VerticalStackLayout>

            <Border
                Grid.Column="1"
                WidthRequest="44"
                HeightRequest="44"
                BackgroundColor="#183660"
                Stroke="#36527B"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                VerticalOptions="Center">

                <Label
                    Text="◉"
                    FontSize="25"
                    TextColor="#FFBF19"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- MAIN CONTENT -->
        <RefreshView
            x:Name="AnnouncementsRefreshView"
            Grid.Row="1"
            Refreshing="OnRefreshing">

            <CollectionView
                x:Name="AnnouncementsCollectionView"
                ItemsSource="{Binding FilteredAnnouncements}"
                SelectionMode="None">

                <CollectionView.Header>
                    <VerticalStackLayout
                        Padding="16,18,16,12"
                        Spacing="17">

                        <!-- SUMMARY CARD -->
                        <Border
                            BackgroundColor="White"
                            Stroke="#E1E7F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Padding="16">

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                                <VerticalStackLayout Spacing="5">
                                    <Label
                                        Text="School Updates"
                                        FontSize="13"
                                        TextColor="#64748B" />

                                    <Label
                                        x:Name="AnnouncementCountLabel"
                                        Text="0 Announcements"
                                        FontSize="24"
                                        FontAttributes="Bold"
                                        TextColor="#061D45" />

                                    <Label
                                        Text="News and notices from your school."
                                        FontSize="11"
                                        TextColor="#64748B" />
                                </VerticalStackLayout>

                                <Border
                                    Grid.Column="1"
                                    BackgroundColor="#FFF2D9"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 15"
                                    WidthRequest="56"
                                    HeightRequest="56"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="!"
                                        FontSize="30"
                                        FontAttributes="Bold"
                                        TextColor="#B77912"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- SEARCH -->
                        <SearchBar
                            x:Name="AnnouncementSearchBar"
                            Placeholder="Search announcements..."
                            BackgroundColor="White"
                            TextColor="#061D45"
                            PlaceholderColor="#8290A5"
                            CancelButtonColor="#061D45"
                            FontSize="13"
                            HeightRequest="52"
                            TextChanged="OnSearchTextChanged" />

                        <!-- CATEGORY FILTERS -->
                        <VerticalStackLayout Spacing="10">
                            <Label
                                Text="Filter by category"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#061D45" />

                            <ScrollView
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never">

                                <HorizontalStackLayout Spacing="8">

                                    <Button
                                        x:Name="AllButton"
                                        Text="All"
                                        CommandParameter="All"
                                        Clicked="OnCategoryClicked"
                                        BackgroundColor="#061D45"
                                        TextColor="White"
                                        CornerRadius="18"
                                        Padding="18,8"
                                        FontSize="12" />

                                    <Button
                                        x:Name="AcademicButton"
                                        Text="Academic"
                                        CommandParameter="Academic"
                                        Clicked="OnCategoryClicked"
                                        BackgroundColor="White"
                                        TextColor="#061D45"
                                        BorderColor="#E0E7F1"
                                        BorderWidth="1"
                                        CornerRadius="18"
                                        Padding="18,8"
                                        FontSize="12" />

                                    <Button
                                        x:Name="EventsButton"
                                        Text="Events"
                                        CommandParameter="Events"
                                        Clicked="OnCategoryClicked"
                                        BackgroundColor="White"
                                        TextColor="#061D45"
                                        BorderColor="#E0E7F1"
                                        BorderWidth="1"
                                        CornerRadius="18"
                                        Padding="18,8"
                                        FontSize="12" />

                                    <Button
                                        x:Name="GeneralButton"
                                        Text="General"
                                        CommandParameter="General"
                                        Clicked="OnCategoryClicked"
                                        BackgroundColor="White"
                                        TextColor="#061D45"
                                        BorderColor="#E0E7F1"
                                        BorderWidth="1"
                                        CornerRadius="18"
                                        Padding="18,8"
                                        FontSize="12" />

                                </HorizontalStackLayout>
                            </ScrollView>
                        </VerticalStackLayout>

                        <!-- STATUS MESSAGE -->
                        <Border
                            x:Name="StatusContainer"
                            IsVisible="False"
                            BackgroundColor="White"
                            Stroke="#E0E7F1"
                            StrokeThickness="1"
                            Padding="14"
                            StrokeShape="RoundRectangle 12">

                            <Label
                                x:Name="StatusLabel"
                                Text=""
                                FontSize="12"
                                TextColor="#C62828"
                                LineBreakMode="WordWrap" />
                        </Border>

                        <!-- RESULTS HEADING -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="Latest Updates"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#061D45"
                                VerticalOptions="Center" />

                            <Grid
                                Grid.Column="1"
                                ColumnDefinitions="Auto,Auto"
                                ColumnSpacing="6"
                                VerticalOptions="Center">

                                <Label
                                    x:Name="ResultsCountLabel"
                                    Text="0 updates"
                                    FontSize="11"
                                    TextColor="#64748B"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="↻"
                                    FontSize="18"
                                    TextColor="#061D45"
                                    VerticalOptions="Center">

                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Tapped="OnRefreshClicked" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </Grid>

                    </VerticalStackLayout>
                </CollectionView.Header>

                <!-- ANNOUNCEMENT CARDS -->
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            BackgroundColor="White"
                            Stroke="#E0E7F1"
                            StrokeThickness="1"
                            Padding="15"
                            Margin="16,0,16,12"
                            StrokeShape="RoundRectangle 16">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnAnnouncementTapped"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="11">

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Border
                                        HorizontalOptions="Start"
                                        BackgroundColor="#FFF2C7"
                                        Padding="10,5"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10">

                                        <Label
                                            Text="{Binding Category}"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="#061D45" />
                                    </Border>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding DateDisplay}"
                                        FontSize="10"
                                        TextColor="#64748B"
                                        VerticalOptions="Center"
                                        HorizontalTextAlignment="End" />
                                </Grid>

                                <Label
                                    Text="{Binding Title}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#061D45"
                                    LineBreakMode="WordWrap" />

                                <Label
                                    Text="{Binding Summary}"
                                    FontSize="13"
                                    TextColor="#52627A"
                                    LineBreakMode="WordWrap"
                                    MaxLines="3" />

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label
                                        Text="{Binding AuthorDisplay}"
                                        FontSize="10"
                                        TextColor="#8290A5"
                                        VerticalOptions="Center"
                                        LineBreakMode="TailTruncation" />

                                    <Label
                                        Grid.Column="1"
                                        Text="Read more  ›"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="#1239C9"
                                        VerticalOptions="Center" />
                                </Grid>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- EMPTY STATE -->
                <CollectionView.EmptyView>
                    <Border
                        BackgroundColor="White"
                        Stroke="#E1E7F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="24"
                        Margin="16,4,16,16">

                        <VerticalStackLayout
                            Spacing="9"
                            HorizontalOptions="Center">

                            <Label
                                Text="◉"
                                FontSize="34"
                                TextColor="#94A3B8"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="No announcements found"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#061D45"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="Try another search or category, or refresh to check for updates."
                                FontSize="12"
                                TextColor="#64748B"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>

                <!-- FOOTER -->
                <CollectionView.Footer>
                    <Label
                        Text="Thuto ke Lesedi • Education is Light"
                        FontSize="11"
                        HorizontalTextAlignment="Center"
                        TextColor="#64748B"
                        Margin="16,12,16,20" />
                </CollectionView.Footer>

            </CollectionView>
        </RefreshView>

        <!-- BOTTOM NAVIGATION -->
        <Grid
            Grid.Row="2"
            BackgroundColor="White"
            Padding="4,8,4,6"
            ColumnDefinitions="*,*,*,*,*"
            ColumnSpacing="2">

            <VerticalStackLayout
                Grid.Column="0"
                Spacing="3"
                HorizontalOptions="Center">

                <Label
                    Text="⌂"
                    FontSize="23"
                    TextColor="#64748B"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Home"
                    FontSize="10"
                    TextColor="#64748B"
                    HorizontalTextAlignment="Center" />

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeTapped" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="3"
                HorizontalOptions="Center">

                <Label
                    Text="▦"
                    FontSize="21"
                    TextColor="#64748B"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Schedule"
                    FontSize="10"
                    TextColor="#64748B"
                    HorizontalTextAlignment="Center" />

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnScheduleTapped" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <VerticalStackLayout
                Grid.Column="2"
                Spacing="3"
                HorizontalOptions="Center">

                <Label
                    Text="◉"
                    FontSize="21"
                    TextColor="#1239C9"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Updates"
                    FontSize="10"
                    FontAttributes="Bold"
                    TextColor="#1239C9"
                    HorizontalTextAlignment="Center" />

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnUpdatesTapped" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <VerticalStackLayout
                Grid.Column="3"
                Spacing="3"
                HorizontalOptions="Center">

                <Label
                    Text="♙"
                    FontSize="21"
                    TextColor="#64748B"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Children"
                    FontSize="10"
                    TextColor="#64748B"
                    HorizontalTextAlignment="Center" />

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnChildrenTapped" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <VerticalStackLayout
                Grid.Column="4"
                Spacing="3"
                HorizontalOptions="Center">

                <Label
                    Text="⚙"
                    FontSize="21"
                    TextColor="#64748B"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Profile"
                    FontSize="10"
                    TextColor="#64748B"
                    HorizontalTextAlignment="Center" />

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileTapped" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
        </Grid>

        <!-- FULL-PAGE LOADING OVERLAY -->
        <Grid
            x:Name="LoadingOverlay"
            Grid.RowSpan="3"
            IsVisible="False"
            ZIndex="100"
            BackgroundColor="#99061D45"
            InputTransparent="False">

            <Border
                BackgroundColor="White"
                Stroke="#E1E7F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="26"
                WidthRequest="260"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <VerticalStackLayout Spacing="14">

                    <ActivityIndicator
                        x:Name="OverlayActivityIndicator"
                        IsRunning="False"
                        IsVisible="True"
                        Color="#1239C9"
                        WidthRequest="42"
                        HeightRequest="42"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Loading announcements..."
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="#061D45"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Please wait while we retrieve the latest school updates."
                        FontSize="12"
                        TextColor="#64748B"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
