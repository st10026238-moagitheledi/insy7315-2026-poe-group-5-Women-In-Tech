<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="KoosMatliApp.Features.Teacher.Views.ChangePasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:KoosMatliApp.Resources.Localization"
    
    Title="Change Password"
    BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>

        <VerticalStackLayout
            Padding="12,10,12,24"
            Spacing="14">


            <!-- Header -->

            <Border
                BackgroundColor="{StaticResource PrimaryBlue}"
                StrokeThickness="0"
                Padding="12">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="32,*">

                    <Label
                        Text="‹"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="{StaticResource SunshineGold}">

                        <Label.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="OnBackTapped" />

                        </Label.GestureRecognizers>

                    </Label>

                    <Label
                        Grid.Column="1"
                        Text="{localization:Translate Key=ChangePassword}"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="{StaticResource SunshineGold}"
                        VerticalOptions="Center" />

                </Grid>

            </Border>


            <Label
                Text="Update Password"
                FontSize="15"
                FontAttributes="Bold"
                TextColor="{StaticResource PrimaryBlue}" />


            <Border
                BackgroundColor="{StaticResource CardSurface}"
                Stroke="{StaticResource Gray200}"
                StrokeThickness="1"
                Padding="12">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>


                <VerticalStackLayout Spacing="16">


                    <!-- Current Password -->

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="{localization:Translate Key=CurrentPassword}"
                            FontSize="9"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PrimaryBlue}" />


                        <Grid
                            ColumnDefinitions="*,44"
                            ColumnSpacing="4">

                            <Entry
                                x:Name="CurrentPasswordEntry"
                                Placeholder="Enter current password"
                                IsPassword="True"
                                FontSize="11"
                                TextColor="{StaticResource Charcoal}" />


                            <Button
                                x:Name="CurrentPasswordEye"
                                Grid.Column="1"
                                Text="👁"
                                Clicked="OnCurrentPasswordEyeClicked"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource PrimaryBlue}"
                                FontSize="15"
                                Padding="0"
                                WidthRequest="40"
                                HeightRequest="40" />

                        </Grid>

                    </VerticalStackLayout>


                    <!-- New Password -->

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="{localization:Translate Key=NewPassword}"
                            FontSize="9"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PrimaryBlue}" />


                        <Grid
                            ColumnDefinitions="*,44"
                            ColumnSpacing="4">

                            <Entry
                                x:Name="NewPasswordEntry"
                                Placeholder="Enter new password"
                                IsPassword="True"
                                FontSize="11"
                                TextColor="{StaticResource Charcoal}" />


                            <Button
                                x:Name="NewPasswordEye"
                                Grid.Column="1"
                                Text="👁"
                                Clicked="OnNewPasswordEyeClicked"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource PrimaryBlue}"
                                FontSize="15"
                                Padding="0"
                                WidthRequest="40"
                                HeightRequest="40" />

                        </Grid>

                    </VerticalStackLayout>


                    <!-- Confirm Password -->

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="{localization:Translate Key=ConfirmPassword}"
                            FontSize="9"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PrimaryBlue}" />


                        <Grid
                            ColumnDefinitions="*,44"
                            ColumnSpacing="4">

                            <Entry
                                x:Name="ConfirmPasswordEntry"
                                Placeholder="Confirm new password"
                                IsPassword="True"
                                FontSize="11"
                                TextColor="{StaticResource Charcoal}" />


                            <Button
                                x:Name="ConfirmPasswordEye"
                                Grid.Column="1"
                                Text="👁"
                                Clicked="OnConfirmPasswordEyeClicked"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource PrimaryBlue}"
                                FontSize="15"
                                Padding="0"
                                WidthRequest="40"
                                HeightRequest="40" />

                        </Grid>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>


            <Button
                Text="{localization:Translate Key=ChangePassword}"
                Clicked="OnChangePasswordClicked"
                BackgroundColor="{StaticResource SunshineGold}"
                TextColor="{StaticResource PrimaryBlue}"
                FontAttributes="Bold"
                HeightRequest="46"
                CornerRadius="8" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>