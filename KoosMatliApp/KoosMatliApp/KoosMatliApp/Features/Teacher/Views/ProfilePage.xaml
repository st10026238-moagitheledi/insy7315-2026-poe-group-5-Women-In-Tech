<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="KoosMatliApp.Features.Teacher.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:KoosMatliApp.Resources.Localization"
    
    Title="Profile"
    BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>

        <VerticalStackLayout
            Padding="16,12,16,24"
            Spacing="14">


            <!-- Header -->

            <Border
                BackgroundColor="{StaticResource PrimaryBlue}"
                StrokeThickness="0"
                Padding="12">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Grid
                    ColumnDefinitions="*,44"
                    ColumnSpacing="10">

                    <Label
                        Text="{localization:Translate Key=Profile}"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{StaticResource SunshineGold}"
                        VerticalOptions="Center" />


                    <Border
                        Grid.Column="1"
                        WidthRequest="40"
                        HeightRequest="40"
                        BackgroundColor="{StaticResource SunshineGold}"
                        StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Label
                            Text="{Binding Initials}"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PrimaryBlue}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Border>

                </Grid>

            </Border>


            <!-- Profile Summary -->

            <Border
                BackgroundColor="{StaticResource CardSurface}"
                Stroke="{StaticResource Gray200}"
                StrokeThickness="1"
                Padding="14">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <Grid
                    ColumnDefinitions="64,*"
                    ColumnSpacing="12">

                    <Border
                        WidthRequest="60"
                        HeightRequest="60"
                        BackgroundColor="{StaticResource SunshineGold}"
                        StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="30" />
                        </Border.StrokeShape>

                        <Label
                            Text="{Binding Initials}"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PrimaryBlue}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Border>


                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="3"
                        VerticalOptions="Center">

                        <Label
                            Text="{Binding FullName}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PrimaryBlue}" />

                        <Label
                            Text="{Binding Position}"
                            FontSize="10"
                            TextColor="{StaticResource Charcoal}" />

                        <Label
                            Text="{Binding EmployeeNumber, StringFormat='Employee No: {0}'}"
                            FontSize="9"
                            TextColor="{StaticResource Gray500}" />

                    </VerticalStackLayout>

                </Grid>

            </Border>


            <!-- Account -->

            <Label
                Text="{localization:Translate Key=Account}"
                FontSize="11"
                FontAttributes="Bold"
                TextColor="{StaticResource Gray500}" />


            <Border
                BackgroundColor="{StaticResource CardSurface}"
                Stroke="{StaticResource Gray200}"
                StrokeThickness="1"
                Padding="0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>


                <VerticalStackLayout Spacing="0">


                    <Grid
                        Padding="12"
                        ColumnDefinitions="*,Auto">

                        <Grid.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="OnPersonalInformationTapped" />

                        </Grid.GestureRecognizers>

                        <Label
                            Text="{localization:Translate Key=PersonalInformation}"
                            FontSize="11"
                            TextColor="{StaticResource PrimaryBlue}" />

                        <Label
                            Grid.Column="1"
                            Text="›"
                            FontSize="18"
                            TextColor="{StaticResource PrimaryBlue}" />

                    </Grid>


                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="{StaticResource Gray200}" />


                    <Grid
                        Padding="12"
                        ColumnDefinitions="*,Auto">

                        <Grid.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="OnChangePasswordTapped" />

                        </Grid.GestureRecognizers>

                        <Label
                            Text="{localization:Translate Key=ChangePassword}"
                            FontSize="11"
                            TextColor="{StaticResource PrimaryBlue}" />

                        <Label
                            Grid.Column="1"
                            Text="›"
                            FontSize="18"
                            TextColor="{StaticResource PrimaryBlue}" />

                    </Grid>

                </VerticalStackLayout>

            </Border>


            <!-- Preferences -->

            <Label
                Text="{localization:Translate Key=Preferences}"
                FontSize="11"
                FontAttributes="Bold"
                TextColor="{StaticResource Gray500}" />


            <Border
                BackgroundColor="{StaticResource CardSurface}"
                Stroke="{StaticResource Gray200}"
                StrokeThickness="1"
                Padding="0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>


                <VerticalStackLayout Spacing="0">


                    <Grid
                        Padding="12"
                        ColumnDefinitions="*,Auto">

                        <Grid.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="OnLanguageTapped" />

                        </Grid.GestureRecognizers>

                        <Label
                            Text="{localization:Translate Key=Language}"
                            FontSize="11"
                            TextColor="{StaticResource PrimaryBlue}" />

                        <Label
                            Grid.Column="1"
                            Text="›"
                            FontSize="18"
                            TextColor="{StaticResource PrimaryBlue}" />

                    </Grid>


                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="{StaticResource Gray200}" />


                    <Grid
                        Padding="12"
                        ColumnDefinitions="*,Auto">

                        <Grid.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="OnNotificationSettingsTapped" />

                        </Grid.GestureRecognizers>

                        <Label
                            Text="{localization:Translate Key=NotificationSettings}"
                            FontSize="11"
                            TextColor="{StaticResource PrimaryBlue}" />

                        <Label
                            Grid.Column="1"
                            Text="›"
                            FontSize="18"
                            TextColor="{StaticResource PrimaryBlue}" />

                    </Grid>

                </VerticalStackLayout>

            </Border>


            <!-- Support -->

            <Label
                Text="{localization:Translate Key=Support}"
                FontSize="11"
                FontAttributes="Bold"
                TextColor="{StaticResource Gray500}" />


            <Border
                BackgroundColor="{StaticResource CardSurface}"
                Stroke="{StaticResource Gray200}"
                StrokeThickness="1"
                Padding="0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>


                <VerticalStackLayout Spacing="0">


                    <Grid
                        Padding="12"
                        ColumnDefinitions="*,Auto">

                        <Grid.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="OnHelpSupportTapped" />

                        </Grid.GestureRecognizers>

                        <Label
                            Text="{localization:Translate Key=HelpSupport}"
                            FontSize="11"
                            TextColor="{StaticResource PrimaryBlue}" />

                        <Label
                            Grid.Column="1"
                            Text="›"
                            FontSize="18"
                            TextColor="{StaticResource PrimaryBlue}" />

                    </Grid>


                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="{StaticResource Gray200}" />


                    <Grid
                        Padding="12"
                        ColumnDefinitions="*,Auto">

                        <Grid.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="OnAboutAppTapped" />

                        </Grid.GestureRecognizers>

                        <Label
                            Text="{localization:Translate Key=AboutApp}"
                            FontSize="11"
                            TextColor="{StaticResource PrimaryBlue}" />

                        <Label
                            Grid.Column="1"
                            Text="›"
                            FontSize="18"
                            TextColor="{StaticResource PrimaryBlue}" />

                    </Grid>

                </VerticalStackLayout>

            </Border>


            <!-- Log Out -->

            <Button
                Text="{localization:Translate Key=Logout}"
                Clicked="OnLogoutClicked"
                BackgroundColor="Transparent"
                TextColor="#B42318"
                BorderColor="#B42318"
                BorderWidth="1"
                FontAttributes="Bold"
                FontSize="11"
                HeightRequest="44"
                CornerRadius="8" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>