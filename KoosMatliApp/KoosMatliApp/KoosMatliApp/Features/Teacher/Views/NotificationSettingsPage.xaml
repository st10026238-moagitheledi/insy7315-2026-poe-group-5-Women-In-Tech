<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="KoosMatliApp.Features.Teacher.Views.NotificationSettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:KoosMatliApp.Resources.Localization"
    
    Title="Notifications"
    BackgroundColor="{StaticResource PageBackground}">

    <VerticalStackLayout
        Padding="12,10,12,24"
        Spacing="14">


        <Border
            BackgroundColor="{StaticResource PrimaryBlue}"
            StrokeThickness="0"
            Padding="12">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <Grid ColumnDefinitions="32,*">

                <Label
                    Text="‹"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="{StaticResource SunshineGold}">

                    <Label.GestureRecognizers>

                        <TapGestureRecognizer
                            Tapped="OnBackTapped" />

                    </Label.GestureRecognizers>

                </Label>

                <Label
                    Grid.Column="1"
                    Text="{localization:Translate Key=NotificationSettings}"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="{StaticResource SunshineGold}"
                    VerticalOptions="Center" />

            </Grid>

        </Border>


        <Border
            BackgroundColor="{StaticResource CardSurface}"
            Stroke="{StaticResource Gray200}"
            StrokeThickness="1"
            Padding="12">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="18">


                <Grid ColumnDefinitions="*,Auto">

                    <Label
                        Text="{localization:Translate Key=AllNotifications}"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{StaticResource PrimaryBlue}" />

                    <Switch
                        Grid.Column="1"
                        IsToggled="{Binding NotificationsEnabled}" />

                </Grid>


                <Grid ColumnDefinitions="*,Auto">

                    <Label
                        Text="{localization:Translate Key=HomeworkNotifications}"
                        FontSize="11"
                        TextColor="{StaticResource PrimaryBlue}" />

                    <Switch
                        Grid.Column="1"
                        IsToggled="{Binding HomeworkNotifications}" />

                </Grid>


                <Grid ColumnDefinitions="*,Auto">

                    <Label
                        Text="{localization:Translate Key=AnnouncementNotifications}"
                        FontSize="11"
                        TextColor="{StaticResource PrimaryBlue}" />

                    <Switch
                        Grid.Column="1"
                        IsToggled="{Binding AnnouncementNotifications}" />

                </Grid>

            </VerticalStackLayout>

        </Border>


        <Button
            Text="{localization:Translate Key=SaveSettings}"
            Clicked="OnSaveSettingsClicked"
            BackgroundColor="{StaticResource SunshineGold}"
            TextColor="{StaticResource PrimaryBlue}"
            FontAttributes="Bold"
            HeightRequest="46"
            CornerRadius="8" />

    </VerticalStackLayout>

</ContentPage>