<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="KoosMatliApp.Features.Teacher.Views.HelpSupportPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Help &amp; Support"
    BackgroundColor="{StaticResource PageBackground}">

    <VerticalStackLayout
        Padding="12,10,12,24"
        Spacing="14">

        <Border
            BackgroundColor="{StaticResource PrimaryBlue}"
            StrokeThickness="0"
            Padding="12">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <Grid ColumnDefinitions="32,*">

                <Label
                    Text="‹"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="{StaticResource SunshineGold}">

                    <Label.GestureRecognizers>

                        <TapGestureRecognizer
                            Tapped="OnBackTapped" />

                    </Label.GestureRecognizers>

                </Label>

                <Label
                    Grid.Column="1"
                    Text="Help &amp; Support"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="{StaticResource SunshineGold}"
                    VerticalOptions="Center" />

            </Grid>

        </Border>


        <Border
            BackgroundColor="{StaticResource CardSurface}"
            Stroke="{StaticResource Gray200}"
            StrokeThickness="1"
            Padding="14">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="8">

                <Label
                    Text="Need assistance?"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="{StaticResource PrimaryBlue}" />

                <Label
                    Text="Contact your school administrator for account access, password assistance, or application support."
                    FontSize="10"
                    TextColor="{StaticResource Charcoal}"
                    LineBreakMode="WordWrap" />

            </VerticalStackLayout>

        </Border>

    </VerticalStackLayout>

</ContentPage>