<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="KoosMatliApp.Features.Teacher.Views.LanguageSettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:KoosMatliApp.Resources.Localization"
    
    Title="Language"
    BackgroundColor="{StaticResource PageBackground}">

    <VerticalStackLayout
        Padding="12,10,12,24"
        Spacing="14">


        <Border
            BackgroundColor="{StaticResource PrimaryBlue}"
            StrokeThickness="0"
            Padding="12">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <Grid ColumnDefinitions="32,*">

                <Label
                    Text="‹"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="{StaticResource SunshineGold}">

                    <Label.GestureRecognizers>

                        <TapGestureRecognizer
                            Tapped="OnBackTapped" />

                    </Label.GestureRecognizers>

                </Label>

                <Label
                    Grid.Column="1"
                    Text="{localization:Translate Key=Language}"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="{StaticResource SunshineGold}"
                    VerticalOptions="Center" />

            </Grid>

        </Border>


        <Label
            Text="{localization:Translate Key=ChooseAppLanguage}"
            FontSize="15"
            FontAttributes="Bold"
            TextColor="{StaticResource PrimaryBlue}" />


        <Border
            BackgroundColor="{StaticResource CardSurface}"
            Stroke="{StaticResource Gray200}"
            StrokeThickness="1"
            Padding="12">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="8">

                <Label
                    Text="{localization:Translate Key=LanguageExplanation}"
                    FontSize="9"
                    TextColor="{StaticResource Gray500}"
                    LineBreakMode="WordWrap" />

                <Picker
                    ItemsSource="{Binding Languages}"
                    SelectedItem="{Binding SelectedLanguage}" />

            </VerticalStackLayout>

        </Border>


        <Button
            Text="{localization:Translate Key=SaveLanguage}"
            Clicked="OnSaveLanguageClicked"
            BackgroundColor="{StaticResource SunshineGold}"
            TextColor="{StaticResource PrimaryBlue}"
            FontAttributes="Bold"
            HeightRequest="46"
            CornerRadius="8" />

    </VerticalStackLayout>

</ContentPage>