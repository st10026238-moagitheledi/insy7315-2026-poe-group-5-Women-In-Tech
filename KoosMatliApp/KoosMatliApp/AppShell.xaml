<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="KoosMatliApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:teacher="clr-namespace:KoosMatliApp.Features.Teacher.Views"

    FlyoutBehavior="Disabled"

    Shell.NavBarIsVisible="False"

    Shell.TabBarBackgroundColor="{StaticResource PrimaryBlue}"
    Shell.TabBarForegroundColor="{StaticResource SunshineGold}"
    Shell.TabBarTitleColor="{StaticResource SunshineGold}"
    Shell.TabBarUnselectedColor="{StaticResource White}">

    <TabBar>

        <ShellContent
            Title="Home"
            Route="TeacherHome"
            ContentTemplate="{DataTemplate teacher:TeacherHomePage}" />

        <ShellContent
            Title="Classes"
            Route="TeacherClasses"
            ContentTemplate="{DataTemplate teacher:ClassesPage}" />

        <ShellContent
            Title="Updates"
            Route="TeacherUpdates"
            ContentTemplate="{DataTemplate teacher:UpdatesPage}" />

        <ShellContent
            Title="Schedule"
            Route="TeacherSchedule"
            ContentTemplate="{DataTemplate teacher:SchedulePage}" />

        <ShellContent
            Title="Profile"
            Route="TeacherProfile"
            ContentTemplate="{DataTemplate teacher:ProfilePage}" />

    </TabBar>

</Shell>