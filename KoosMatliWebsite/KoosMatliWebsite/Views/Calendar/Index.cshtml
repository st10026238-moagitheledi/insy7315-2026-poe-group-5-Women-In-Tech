@model IEnumerable<KoosMatliWebsite.DTOs.SchoolEventDto>

@using System.Text.Json

@{
    ViewData["Title"] = "School Calendar";

    var publishedEvents = Model?
        .Where(e => e.IsPublished)
        .OrderBy(e => e.Date)
        .ToList()
        ?? new List<KoosMatliWebsite.DTOs.SchoolEventDto>();

    var calendarEventsJson = JsonSerializer.Serialize(
        publishedEvents,
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        }
    );
}


<!-- =========================================================
     SCHOOL CALENDAR
     ========================================================= -->

<section class="calendar-page">

    <div class="container">

        <!-- =========================
             PAGE HEADING
             ========================= -->

        <div class="calendar-heading">

            <span>SCHOOL YEAR 2026</span>

            <h1>School Calendar</h1>

            <p>
                Stay up to date with important school dates,
                events, meetings and activities.
            </p>

        </div>


        <!-- =========================
             MONTH CONTROLS
             ========================= -->

        <div class="calendar-controls">

            <button type="button"
                    class="calendar-nav"
                    id="previousMonth"
                    aria-label="Previous month">

                <i class="fa-solid fa-chevron-left"></i>

            </button>


            <h2 id="calendarMonth">
                October 2026
            </h2>


            <button type="button"
                    class="calendar-nav"
                    id="nextMonth"
                    aria-label="Next month">

                <i class="fa-solid fa-chevron-right"></i>

            </button>

        </div>


        <!-- =========================
             MAIN LAYOUT
             ========================= -->

        <div class="calendar-layout">


            <!-- =========================
                 CALENDAR
                 ========================= -->

            <div class="calendar-container">


                <!-- WEEKDAYS -->

                <div class="calendar-weekdays">

                    <div>MON</div>
                    <div>TUE</div>
                    <div>WED</div>
                    <div>THU</div>
                    <div>FRI</div>
                    <div>SAT</div>
                    <div>SUN</div>

                </div>


                <!-- CALENDAR DAYS -->

                <div class="calendar-days"
                     id="calendarDays">
                </div>

            </div>


            <!-- =========================
                 UPCOMING EVENTS
                 ========================= -->

            <aside class="upcoming-events">

                <div class="events-heading">

                    <h2>UPCOMING EVENTS</h2>

                    <i class="fa-regular fa-calendar"></i>

                </div>


                <div class="events-list">

                    @if (publishedEvents.Any())
                    {
                        foreach (var schoolEvent in publishedEvents)
                        {
                            <article class="event-card"
                                     data-event-id="@schoolEvent.Id"
                                     data-event-date="@schoolEvent.Date.ToString("yyyy-MM-dd")">

                                <!-- EVENT DATE -->

                                <div class="event-date">

                                    <strong>
                                        @schoolEvent.Date.ToString("dd")
                                    </strong>

                                    <span>
                                        @schoolEvent.Date.ToString("MMM")
                                    </span>

                                </div>


                                <!-- EVENT INFORMATION -->

                                <div class="event-information">

                                    <h3>
                                        @schoolEvent.Title
                                    </h3>


                                    @if (!string.IsNullOrWhiteSpace(schoolEvent.Description))
                                    {
                                        <p>
                                            @schoolEvent.Description
                                        </p>
                                    }


                                    <div class="event-meta">

                                        @if (!string.IsNullOrWhiteSpace(schoolEvent.Time))
                                        {
                                            <span>
                                                <i class="fa-regular fa-clock"></i>
                                                @schoolEvent.Time
                                            </span>
                                        }


                                        @if (!string.IsNullOrWhiteSpace(schoolEvent.Location))
                                        {
                                            <span>
                                                <i class="fa-solid fa-location-dot"></i>
                                                @schoolEvent.Location
                                            </span>
                                        }

                                    </div>

                                </div>

                            </article>
                        }
                    }
                    else
                    {
                        <div class="events-empty">

                            <i class="fa-regular fa-calendar-xmark"></i>

                            <h3>
                                No upcoming events
                            </h3>

                            <p>
                                There are currently no published
                                events on the school calendar.
                            </p>

                        </div>
                    }

                </div>

            </aside>

        </div>

    </div>

</section>


<!-- =========================================================
     CALENDAR EVENT DATA
     ========================================================= -->

<script>

    const schoolEvents = @Html.Raw(calendarEventsJson);

</script>


<!-- =========================================================
     CALENDAR JAVASCRIPT
     ========================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const calendarDays =
            document.getElementById("calendarDays");

        const calendarMonth =
            document.getElementById("calendarMonth");

        const previousMonth =
            document.getElementById("previousMonth");

        const nextMonth =
            document.getElementById("nextMonth");


        /*
         * Start the calendar on October 2026.
         */
        let currentDate =
            new Date(2026, 9, 1);


        /*
         * Month names.
         */
        const monthNames = [
            "January",
            "February",
            "March",
            "April",
            "May",
            "June",
            "July",
            "August",
            "September",
            "October",
            "November",
            "December"
        ];


        /*
         * Convert a JavaScript Date
         * into YYYY-MM-DD format.
         */
        function formatDate(date) {

            const year =
                date.getFullYear();

            const month =
                String(date.getMonth() + 1)
                    .padStart(2, "0");

            const day =
                String(date.getDate())
                    .padStart(2, "0");

            return `${year}-${month}-${day}`;
        }


        /*
         * Get all events for a specific date.
         */
        function getEventsForDate(dateString) {

            return schoolEvents.filter(function (event) {

                const eventDate =
                    new Date(event.date);

                return formatDate(eventDate) === dateString;

            });

        }


        /*
         * Render the calendar.
         */
        function renderCalendar() {

            calendarDays.innerHTML = "";


            const year =
                currentDate.getFullYear();

            const month =
                currentDate.getMonth();


            /*
             * Update month heading.
             */
            calendarMonth.textContent =
                `${monthNames[month]} ${year}`;


            /*
             * Find the first day of the month.
             *
             * JavaScript:
             * Sunday = 0
             * Monday = 1
             *
             * Convert Sunday to 7
             * because our calendar starts Monday.
             */
            let firstDay =
                new Date(year, month, 1).getDay();

            firstDay =
                firstDay === 0 ? 7 : firstDay;


            /*
             * Number of days in the month.
             */
            const daysInMonth =
                new Date(
                    year,
                    month + 1,
                    0
                ).getDate();


            /*
             * Add empty cells before
             * the first day.
             */
            for (let i = 1; i < firstDay; i++) {

                const emptyDay =
                    document.createElement("div");

                emptyDay.classList.add(
                    "calendar-day",
                    "empty"
                );

                calendarDays.appendChild(
                    emptyDay
                );
            }


            /*
             * Create each calendar day.
             */
            for (
                let dayNumber = 1;
                dayNumber <= daysInMonth;
                dayNumber++
            ) {

                const day =
                    document.createElement("div");

                day.classList.add(
                    "calendar-day"
                );


                /*
                 * Create the date.
                 */
                const date =
                    new Date(
                        year,
                        month,
                        dayNumber
                    );


                const dateString =
                    formatDate(date);


                /*
                 * Create day number.
                 */
                const dayNumberElement =
                    document.createElement("span");

                dayNumberElement.classList.add(
                    "calendar-day-number"
                );

                dayNumberElement.textContent =
                    dayNumber;

                day.appendChild(
                    dayNumberElement
                );


                /*
                 * Highlight today's date.
                 */
                const today =
                    new Date();

                if (
                    date.getFullYear() === today.getFullYear() &&
                    date.getMonth() === today.getMonth() &&
                    date.getDate() === today.getDate()
                ) {

                    day.classList.add(
                        "today"
                    );
                }


                /*
                 * Find events for this day.
                 */
                const dayEvents =
                    getEventsForDate(
                        dateString
                    );


                /*
                 * Add events to the calendar day.
                 */
                if (dayEvents.length > 0) {

                    day.classList.add(
                        "has-event"
                    );


                    day.dataset.date =
                        dateString;


                    /*
                     * Display each event.
                     */
                    dayEvents.forEach(function (event) {

                        const eventElement =
                            document.createElement("span");

                        eventElement.classList.add(
                            "calendar-event"
                        );

                        eventElement.textContent =
                            event.title;


                        /*
                         * Clicking an event
                         * scrolls to its event card.
                         */
                        eventElement.addEventListener(
                            "click",
                            function (clickEvent) {

                                clickEvent.stopPropagation();

                                const eventCard =
                                    document.querySelector(
                                        `.event-card[data-event-id="${event.id}"]`
                                    );


                                if (eventCard) {

                                    eventCard.scrollIntoView({
                                        behavior: "smooth",
                                        block: "center"
                                    });


                                    /*
                                     * Temporary highlight.
                                     */
                                    eventCard.classList.add(
                                        "event-highlight"
                                    );


                                    setTimeout(function () {

                                        eventCard.classList.remove(
                                            "event-highlight"
                                        );

                                    }, 2000);

                                }

                            }
                        );


                        day.appendChild(
                            eventElement
                        );

                    });


                    /*
                     * Clicking the calendar day
                     * opens the first event.
                     */
                    day.addEventListener(
                        "click",
                        function () {

                            const firstEvent =
                                dayEvents[0];


                            const eventCard =
                                document.querySelector(
                                    `.event-card[data-event-id="${firstEvent.id}"]`
                                );


                            if (eventCard) {

                                eventCard.scrollIntoView({
                                    behavior: "smooth",
                                    block: "center"
                                });


                                eventCard.classList.add(
                                    "event-highlight"
                                );


                                setTimeout(function () {

                                    eventCard.classList.remove(
                                        "event-highlight"
                                    );

                                }, 2000);

                            }

                        }
                    );

                }


                /*
                 * Add the day to the calendar.
                 */
                calendarDays.appendChild(
                    day
                );

            }

        }


        /*
         * Previous month button.
         */
        previousMonth.addEventListener(
            "click",
            function () {

                currentDate.setMonth(
                    currentDate.getMonth() - 1
                );

                renderCalendar();

            }
        );


        /*
         * Next month button.
         */
        nextMonth.addEventListener(
            "click",
            function () {

                currentDate.setMonth(
                    currentDate.getMonth() + 1
                );

                renderCalendar();

            }
        );


        /*
         * Initial render.
         */
        renderCalendar();

    });

</script>