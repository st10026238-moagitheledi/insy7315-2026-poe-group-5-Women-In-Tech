@model IEnumerable<KoosMatliWebsite.Models.SchoolEvent>

@{
    ViewData["Title"] = "School Calendar";
}


<!-- =====================================================
     SCHOOL CALENDAR
     ===================================================== -->

<section class="calendar-page">

    <div class="container">


        <!-- PAGE HEADING -->

        <div class="calendar-heading">

            <div>

                <span>SCHOOL YEAR 2026</span>

                <h1>School Calendar</h1>

                <p>
                    Stay up to date with important school dates,
                    events, meetings and activities.
                </p>

            </div>

        </div>


        <!-- MONTH CONTROLS -->

        <div class="calendar-controls">

            <button class="calendar-nav"
                    id="previousMonth"
                    type="button">

                <i class="fa-solid fa-chevron-left"></i>

            </button>


            <h2 id="calendarMonth">
                September 2026
            </h2>


            <button class="calendar-nav"
                    id="nextMonth"
                    type="button">

                <i class="fa-solid fa-chevron-right"></i>

            </button>

        </div>


        <!-- CALENDAR + EVENTS -->

        <div class="calendar-layout">


            <!-- =================================================
                 CALENDAR
                 ================================================= -->

            <div class="calendar-container">

                <div class="calendar-weekdays">

                    <div>MON</div>
                    <div>TUE</div>
                    <div>WED</div>
                    <div>THU</div>
                    <div>FRI</div>
                    <div>SAT</div>
                    <div>SUN</div>

                </div>


                <div class="calendar-days"
                     id="calendarDays">
                </div>

            </div>


            <!-- =================================================
                 UPCOMING EVENTS
                 ================================================= -->

            <aside class="upcoming-events">

                <div class="events-heading">

                    <h2>UPCOMING EVENTS</h2>

                    <i class="fa-regular fa-calendar"></i>

                </div>


                <div class="events-list">

                    @foreach (var schoolEvent in Model.OrderBy(e => e.Date))
                    {
                        <article class="event-card">

                            <div class="event-date">

                                <strong>
                                    @schoolEvent.Date.ToString("dd")
                                </strong>

                                <span>
                                    @schoolEvent.Date.ToString("MMM")
                                </span>

                            </div>


                            <div class="event-information">

                                <h3>
                                    @schoolEvent.Title
                                </h3>

                                <p>
                                    @schoolEvent.Description
                                </p>


                                <div class="event-meta">

                                    <span>

                                        <i class="fa-regular fa-clock"></i>

                                        @schoolEvent.Time

                                    </span>


                                    <span>

                                        <i class="fa-solid fa-location-dot"></i>

                                        @schoolEvent.Location

                                    </span>

                                </div>

                            </div>

                        </article>
                    }

                </div>

            </aside>


        </div>

    </div>

</section>