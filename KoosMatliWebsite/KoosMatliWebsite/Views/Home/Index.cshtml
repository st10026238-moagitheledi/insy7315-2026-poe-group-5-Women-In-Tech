@{
    ViewData["Title"] = "Home";
}


<!-- ================= HERO ================= -->

<section class="home-hero">

    <div class="hero-overlay">

        <div class="container hero-content">

            <div class="hero-text">

                <h1>
                    WHERE EDUCATION
                    <span>LIGHTS THE WAY</span>
                </h1>

                <p>
                    Koos Matli aims to inspire young minds,
                    nurture their potential, and equip them
                    with the knowledge and values needed to
                    build a brighter future.
                </p>

                <div class="hero-buttons">

                    <a asp-controller="About"
                       asp-action="Index"
                       class="btn btn-primary">

                        LEARN MORE

                    </a>

                    <a asp-controller="Admissions"
                       asp-action="Index"
                       class="btn btn-outline">

                        ADMISSIONS

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- ================= SCHOOL VALUES ================= -->

<section class="home-values">

    <div class="container values-container">


        <div class="value-item">

            <div class="value-icon">

                <i class="fa-solid fa-book-open"></i>

            </div>

            <div>

                <h3>Quality Education</h3>

                <p>
                    Excellence in learning
                </p>

            </div>

        </div>


        <div class="value-item">

            <div class="value-icon">

                <i class="fa-solid fa-school"></i>

            </div>

            <div>

                <h3>Safe Environment</h3>

                <p>
                    A secure and caring space
                </p>

            </div>

        </div>


        <div class="value-item">

            <div class="value-icon">

                <i class="fa-solid fa-people-group"></i>

            </div>

            <div>

                <h3>Inclusive Community</h3>

                <p>
                    Everyone belongs
                </p>

            </div>

        </div>


        <div class="value-item">

            <div class="value-icon">

                <i class="fa-solid fa-star"></i>

            </div>

            <div>

                <h3>Bright Futures</h3>

                <p>
                    Preparing leaders of tomorrow
                </p>

            </div>

        </div>

    </div>

</section>