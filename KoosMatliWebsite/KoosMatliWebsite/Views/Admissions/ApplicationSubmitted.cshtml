@{
    ViewData["Title"] = "Application Submitted";
}

<section class="application-success-section">

    <div class="container">

        <div class="application-success">

            <div class="success-icon">

                <i class="fa-solid fa-check"></i>

            </div>

            <h1>
                Application Submitted
            </h1>

            <p>
                Thank you for submitting your application
                to Koos Matli Primary School.
            </p>

            <p>
                Your application has been received and will
                be reviewed by the school.
            </p>

            <a asp-controller="Admissions"
               asp-action="Index"
               class="application-submit">

                RETURN TO ADMISSIONS

                <i class="fa-solid fa-arrow-right"></i>

            </a>

        </div>

    </div>

</section>