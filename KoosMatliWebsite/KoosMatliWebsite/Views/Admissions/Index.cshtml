@{
    ViewData["Title"] = "Admissions";
}

<!-- =========================================================
     ADMISSIONS HERO
     ========================================================= -->

<section class="admissions-hero">

    <div class="container admissions-hero-container">

        <!-- LEFT CONTENT -->

        <div class="admissions-hero-content">

            <div class="admissions-heading">

                <h1>
                    ADMISSIONS
                </h1>

                <h2>
                    Start Your Child's
                    <br />
                    Journey With Us
                </h2>

            </div>


            <p class="admissions-intro">

                We welcome families who are looking for a
                nurturing, supportive, and engaging environment
                where every learner has the opportunity to grow,
                learn, and shine.

                Our admissions process is designed to be simple
                and transparent, making it easy for families to
                take the first step toward joining our school
                community.

            </p>

        </div>


        <!-- RIGHT IMAGE -->

        <div class="admissions-image-wrapper">

            <div class="admissions-dots"></div>

            <div class="admissions-image-circle"></div>

            <img src="https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=1000&q=85"
                 alt="Learner studying at school"
                 class="admissions-main-image" />

        </div>

    </div>

</section>



<!-- =========================================================
     HOW TO APPLY
     ========================================================= -->

<section class="admissions-steps-section">

    <div class="container">

        <div class="admissions-section-heading">

            <span>
                ADMISSIONS PROCESS
            </span>

            <h2>
                How To Apply
            </h2>

            <p>
                Follow these simple steps to begin your child's
                journey with Koos Matli Primary School.
            </p>

        </div>


        <div class="admissions-steps">

            <!-- STEP 1 -->

            <div class="admission-step">

                <div class="step-number">
                    1
                </div>

                <div class="step-content">

                    <span>
                        STEP 1
                    </span>

                    <h3>
                        Get Information
                    </h3>

                    <p>
                        Read about our school, requirements,
                        programmes and admissions process.
                    </p>

                </div>

            </div>


            <!-- STEP 2 -->

            <div class="admission-step">

                <div class="step-number">
                    2
                </div>

                <div class="step-content">

                    <span>
                        STEP 2
                    </span>

                    <h3>
                        Complete Form
                    </h3>

                    <p>
                        Fill in the online application form
                        with your child's details.
                    </p>

                </div>

            </div>


            <!-- STEP 3 -->

            <div class="admission-step">

                <div class="step-number">
                    3
                </div>

                <div class="step-content">

                    <span>
                        STEP 3
                    </span>

                    <h3>
                        Submit Documents
                    </h3>

                    <p>
                        Provide the required supporting
                        documents with your application.
                    </p>

                </div>

            </div>


            <!-- STEP 4 -->

            <div class="admission-step">

                <div class="step-number">
                    4
                </div>

                <div class="step-content">

                    <span>
                        STEP 4
                    </span>

                    <h3>
                        Assessment
                    </h3>

                    <p>
                        Your learner may be invited to
                        complete an assessment where required.
                    </p>

                </div>

            </div>


            <!-- STEP 5 -->

            <div class="admission-step">

                <div class="step-number">
                    5
                </div>

                <div class="step-content">

                    <span>
                        STEP 5
                    </span>

                    <h3>
                        Decision
                    </h3>

                    <p>
                        We will inform you of the outcome
                        and next steps.
                    </p>

                </div>

            </div>

        </div>


        <!-- APPLY BUTTON -->

        <div class="admissions-apply">

            <a asp-controller="Admissions"
               asp-action="Apply"
               class="btn btn-primary">

                APPLY NOW

                <i class="fa-solid fa-arrow-right"></i>

            </a>

        </div>

    </div>

</section>



<!-- =========================================================
     WHAT YOU'LL NEED
     ========================================================= -->

<section class="admissions-requirements">

    <div class="container">

        <div class="admissions-section-heading">

            <span>
                BEFORE YOU APPLY
            </span>

            <h2>
                What You'll Need
            </h2>

            <p>
                Please have the following information available
                when completing your application.
            </p>

        </div>


        <div class="requirements-grid">

            <!-- REQUIREMENT 1 -->

            <div class="requirement-card">

                <div class="requirement-icon">

                    <i class="fa-solid fa-id-card"></i>

                </div>

                <div>

                    <h3>
                        Learner Information
                    </h3>

                    <p>
                        Basic personal and educational
                        information about the learner.
                    </p>

                </div>

            </div>


            <!-- REQUIREMENT 2 -->

            <div class="requirement-card">

                <div class="requirement-icon">

                    <i class="fa-solid fa-user"></i>

                </div>

                <div>

                    <h3>
                        Parent / Guardian Details
                    </h3>

                    <p>
                        Contact information for the parent
                        or legal guardian.
                    </p>

                </div>

            </div>


            <!-- REQUIREMENT 3 -->

            <div class="requirement-card">

                <div class="requirement-icon">

                    <i class="fa-solid fa-file-lines"></i>

                </div>

                <div>

                    <h3>
                        Supporting Documents
                    </h3>

                    <p>
                        Have the required supporting
                        documentation ready.
                    </p>

                </div>

            </div>


            <!-- REQUIREMENT 4 -->

            <div class="requirement-card">

                <div class="requirement-icon">

                    <i class="fa-solid fa-school"></i>

                </div>

                <div>

                    <h3>
                        Previous School Details
                    </h3>

                    <p>
                        Information about the learner's
                        previous school where applicable.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =========================================================
     ADMISSIONS CTA
     ========================================================= -->

<section class="admissions-cta">

    <div class="container admissions-cta-container">

        <div>

            <span>
                READY TO GET STARTED?
            </span>

            <h2>
                Give Your Child A Brighter Future
            </h2>

            <p>
                Take the first step towards joining the
                Koos Matli Primary School community.
            </p>

        </div>


        <div class="admissions-cta-buttons">

            <a asp-controller="Admissions"
               asp-action="Apply"
               class="btn btn-primary">

                APPLY NOW

            </a>


            <a asp-controller="Contact"
               asp-action="Index"
               class="btn btn-outline">

                CONTACT US

            </a>

        </div>

    </div>

</section>