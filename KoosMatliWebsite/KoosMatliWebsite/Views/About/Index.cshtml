@{
    ViewData["Title"] = "About Us";
}


<!-- =====================================================
     ABOUT US HERO
     ===================================================== -->

<section class="about-hero">

    <div class="container about-hero-container">

        <!-- LEFT SIDE -->

        <div class="about-intro">

            <div class="about-heading">

                <h1>ABOUT US</h1>

                <h2>Where Education Is Light</h2>

                <div class="heading-line"></div>

            </div>


            <p>
                Our school is a community-focused primary school
                in Mamelodi committed to providing quality
                education in a safe, inclusive, and nurturing
                environment.
            </p>

            <p>
                We believe that every learner has the potential
                to shine, and through education, support, and
                meaningful opportunities, we empower our learners
                to grow into confident individuals who can make
                a positive difference in their communities.
            </p>

        </div>


        <!-- RIGHT SIDE -->

        <div class="about-image-wrapper">

            <img src="https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=900&q=80"
                 alt="Koos Matli learners"
                 class="about-main-image" />

        </div>

    </div>

</section>


<!-- =====================================================
     VISION / MISSION / VALUES
     ===================================================== -->

<section class="about-info-section">

    <div class="container about-info-grid">


        <!-- VISION -->

        <article class="about-info-card">

            <div class="about-card-icon">

                <i class="fa-regular fa-eye"></i>

            </div>

            <div>

                <h3>Our Vision</h3>

                <p>
                    To be a leading primary school that inspires
                    learners to become confident, responsible and
                    future-ready citizens.
                </p>

            </div>

        </article>


        <!-- MISSION -->

        <article class="about-info-card">

            <div class="about-card-icon">

                <i class="fa-solid fa-bullseye"></i>

            </div>

            <div>

                <h3>Our Mission</h3>

                <p>
                    To provide holistic education in a nurturing
                    environment through dedicated teaching and
                    strong community partnerships.
                </p>

            </div>

        </article>


        <!-- VALUES -->

        <article class="about-info-card">

            <div class="about-card-icon">

                <i class="fa-regular fa-heart"></i>

            </div>

            <div>

                <h3>Our Values</h3>

                <ul>

                    <li>Respect</li>

                    <li>Integrity</li>

                    <li>Excellence</li>

                    <li>Responsibility</li>

                    <li>Ubuntu</li>

                </ul>

            </div>

        </article>


    </div>

</section>