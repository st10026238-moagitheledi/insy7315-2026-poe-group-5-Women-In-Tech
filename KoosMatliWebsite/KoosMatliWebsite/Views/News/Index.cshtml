@{
    ViewData["Title"] = "News & Announcements";
}


<!-- =========================================================
     NEWS HERO
     ========================================================= -->

<section class="news-hero">

    <div class="container news-hero-container">

        <!-- HERO TEXT -->

        <div class="news-hero-content">

            <h1>
                NEWS & ANNOUNCEMENTS
            </h1>

            <h2>
                What's Happening at Our School?
            </h2>

            <p>
                Stay connected with the latest news,
                achievements, events, and important updates
                from our school community.
            </p>

        </div>


        <!-- HERO ICON -->

        <div class="news-hero-icon">

            <i class="fa-solid fa-bullhorn"></i>

            <span class="news-sound sound-one"></span>
            <span class="news-sound sound-two"></span>
            <span class="news-sound sound-three"></span>

        </div>

    </div>

</section>



<!-- =========================================================
     NEWS CONTENT
     ========================================================= -->

<section class="news-section">

    <div class="container">


        <!-- =================================================
             FILTERS
             ================================================= -->

        <div class="news-filters">

            <button type="button"
                    class="news-filter active"
                    data-news-filter="all">

                ALL

            </button>


            <button type="button"
                    class="news-filter"
                    data-news-filter="announcement">

                ANNOUNCEMENTS

            </button>


            <button type="button"
                    class="news-filter"
                    data-news-filter="event">

                EVENTS

            </button>


            <button type="button"
                    class="news-filter"
                    data-news-filter="achievement">

                ACHIEVEMENTS

            </button>


            <button type="button"
                    class="news-filter"
                    data-news-filter="general">

                GENERAL

            </button>

        </div>



        <!-- =================================================
             NEWS LIST
             ================================================= -->

        <div class="news-list">


            <!-- NEWS ITEM 1 -->

            <article class="news-item"
                     data-news-category="achievement">

                <div class="news-thumbnail">

                    <img src="https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=700&q=80"
                         alt="Learners participating in an academic activity" />

                </div>


                <div class="news-item-content">

                    <div class="news-item-top">

                        <h3>
                            Grade 5 Learners Excel in District Quiz
                        </h3>

                        <span class="news-date">
                            12 May 2024
                        </span>

                    </div>


                    <div class="news-meta">

                        <span class="news-badge achievement">
                            Achievement
                        </span>

                    </div>


                    <p>
                        Our Grade 5 team showed excellent
                        knowledge and teamwork at the
                        district quiz competition.
                    </p>

                </div>

            </article>



            <!-- NEWS ITEM 2 -->

            <article class="news-item"
                     data-news-category="event">

                <div class="news-thumbnail">

                    <img src="https://images.unsplash.com/photo-1461896836934-ffe607ba8211?auto=format&fit=crop&w=700&q=80"
                         alt="Learners participating in sports" />

                </div>


                <div class="news-item-content">

                    <div class="news-item-top">

                        <h3>
                            School Sports Day a Huge Success!
                        </h3>

                        <span class="news-date">
                            05 May 2024
                        </span>

                    </div>


                    <div class="news-meta">

                        <span class="news-badge event">
                            Event
                        </span>

                    </div>


                    <p>
                        Thank you to all our learners, parents
                        and staff for making Sports Day a
                        memorable event.
                    </p>

                </div>

            </article>



            <!-- NEWS ITEM 3 -->

            <article class="news-item"
                     data-news-category="announcement">

                <div class="news-thumbnail">

                    <img src="https://images.unsplash.com/photo-1546410531-bb4caa6b424d?auto=format&fit=crop&w=700&q=80"
                         alt="School meeting" />

                </div>


                <div class="news-item-content">

                    <div class="news-item-top">

                        <h3>
                            Parent-Teacher Meetings
                        </h3>

                        <span class="news-date">
                            30 Apr 2024
                        </span>

                    </div>


                    <div class="news-meta">

                        <span class="news-badge announcement">
                            Announcement
                        </span>

                    </div>


                    <p>
                        Parent-Teacher meetings will be held
                        on 20 May 2024. More details to follow.
                    </p>

                </div>

            </article>



            <!-- NEWS ITEM 4 -->

            <article class="news-item"
                     data-news-category="general">

                <div class="news-thumbnail">

                    <img src="https://images.unsplash.com/photo-1580582932707-520aed937b7b?auto=format&fit=crop&w=700&q=80"
                         alt="School building" />

                </div>


                <div class="news-item-content">

                    <div class="news-item-top">

                        <h3>
                            Welcome Back to Koos Matli
                        </h3>

                        <span class="news-date">
                            22 Apr 2024
                        </span>

                    </div>


                    <div class="news-meta">

                        <span class="news-badge general">
                            General
                        </span>

                    </div>


                    <p>
                        We look forward to another exciting
                        term of learning, growth and
                        community.
                    </p>

                </div>

            </article>

        </div>



        <!-- =================================================
             NO RESULTS MESSAGE
             ================================================= -->

        <div class="news-empty"
             id="newsEmpty">

            <i class="fa-regular fa-newspaper"></i>

            <h3>
                No news found
            </h3>

            <p>
                There are currently no posts in this category.
            </p>

        </div>



        <!-- =================================================
             VIEW ALL BUTTON
             ================================================= -->

        <div class="news-view-all">

            <button type="button"
                    class="btn btn-primary"
                    id="viewAllNews">

                VIEW ALL NEWS

                <i class="fa-solid fa-arrow-right"></i>

            </button>

        </div>

    </div>

</section>