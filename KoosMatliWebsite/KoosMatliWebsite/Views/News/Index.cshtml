@model IEnumerable<KoosMatliWebsite.DTOs.NewsDto>

@{
    ViewData["Title"] = "News & Announcements";
}


<!-- =========================================================
     NEWS HERO
     ========================================================= -->

<section class="news-hero">

    <div class="container news-hero-container">

        <!-- HERO TEXT -->

        <div class="news-hero-content">

            <h1>
                NEWS & ANNOUNCEMENTS
            </h1>

            <h2>
                What's Happening at Our School?
            </h2>

            <p>
                Stay connected with the latest news,
                achievements, events, and important updates
                from our school community.
            </p>

        </div>


        <!-- HERO ICON -->

        <div class="news-hero-icon">

            <i class="fa-solid fa-bullhorn"></i>

            <span class="news-sound sound-one"></span>
            <span class="news-sound sound-two"></span>
            <span class="news-sound sound-three"></span>

        </div>

    </div>

</section>



<!-- =========================================================
     NEWS CONTENT
     ========================================================= -->

<section class="news-section">

    <div class="container">


        <!-- =================================================
             FILTERS
             ================================================= -->

        <div class="news-filters">

            <button type="button"
                    class="news-filter active"
                    data-news-filter="all">

                ALL

            </button>


            <button type="button"
                    class="news-filter"
                    data-news-filter="announcement">

                ANNOUNCEMENTS

            </button>


            <button type="button"
                    class="news-filter"
                    data-news-filter="event">

                EVENTS

            </button>


            <button type="button"
                    class="news-filter"
                    data-news-filter="achievement">

                ACHIEVEMENTS

            </button>


            <button type="button"
                    class="news-filter"
                    data-news-filter="general">

                GENERAL

            </button>

        </div>



        <!-- =================================================
             NEWS LIST
             ================================================= -->

        <div class="news-list">

            @if (Model != null && Model.Any())
            {
                foreach (var news in Model.Where(n => n.IsPublished))
                {
                    var category = string.IsNullOrWhiteSpace(news.Category)
                        ? "general"
                        : news.Category.ToLower();

                    <article class="news-item"
                             data-news-category="@category"
                             data-news-id="@news.Id">

                        <!-- NEWS IMAGE -->

                        <div class="news-thumbnail">

                            @if (!string.IsNullOrWhiteSpace(news.ImageUrl))
                            {
                                <img src="@news.ImageUrl"
                                     alt="@news.Title" />
                            }
                            else
                            {
                                <img src="https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=700&q=80"
                                     alt="@news.Title" />
                            }

                        </div>


                        <!-- NEWS CONTENT -->

                        <div class="news-item-content">

                            <div class="news-item-top">

                                <h3>
                                    @news.Title
                                </h3>

                                <span class="news-date">
                                    @news.PublishedDate.ToString("dd MMM yyyy")
                                </span>

                            </div>


                            <div class="news-meta">

                                <span class="news-badge @category">
                                    @category
                                </span>

                            </div>


                            <p>
                                @news.Content
                            </p>

                        </div>

                    </article>
                }
            }

        </div>



        <!-- =================================================
             NO RESULTS MESSAGE
             ================================================= -->

        <div class="news-empty"
             id="newsEmpty"
             style="display: @(Model == null || !Model.Any(n => n.IsPublished) ? "block" : "none");">

            <i class="fa-regular fa-newspaper"></i>

            <h3>
                No news found
            </h3>

            <p>
                There are currently no posts in this category.
            </p>

        </div>



        <!-- =================================================
             VIEW ALL BUTTON
             ================================================= -->

        <div class="news-view-all">

            <button type="button"
                    class="btn btn-primary"
                    id="viewAllNews">

                VIEW ALL NEWS

                <i class="fa-solid fa-arrow-right"></i>

            </button>

        </div>

    </div>

</section>