@model IEnumerable<KoosMatliWebsite.DTOs.NewsDto>

@{
    ViewData["Title"] = "News & Announcements";
}

<!-- =========================================================
     NEWS HERO
     ========================================================= -->

<section class="news-hero">

    <div class="container news-hero-container">

        <div class="news-hero-content">

            <h1>
                NEWS & ANNOUNCEMENTS
            </h1>

            <h2>
                What's Happening at Our School?
            </h2>

            <p>
                Stay connected with the latest news,
                achievements, events, and important updates
                from our school community.
            </p>

        </div>

        <div class="news-hero-icon">

            <i class="fa-solid fa-bullhorn"></i>

            <span class="news-sound sound-one"></span>
            <span class="news-sound sound-two"></span>
            <span class="news-sound sound-three"></span>

        </div>

    </div>

</section>


<!-- =========================================================
     NEWS CONTENT
     ========================================================= -->

<section class="news-section">

    <div class="container">

        <!-- =================================================
             FILTERS
             ================================================= -->

        <div class="news-filters">

            <button type="button"
                    class="news-filter active"
                    data-news-filter="all">

                ALL

            </button>

            <button type="button"
                    class="news-filter"
                    data-news-filter="announcements">

                ANNOUNCEMENTS

            </button>

            <button type="button"
                    class="news-filter"
                    data-news-filter="events">

                EVENTS

            </button>

            <button type="button"
                    class="news-filter"
                    data-news-filter="achievements">

                ACHIEVEMENTS

            </button>

            <button type="button"
                    class="news-filter"
                    data-news-filter="general">

                GENERAL

            </button>

        </div>


        <!-- =================================================
             NEWS LIST
             ================================================= -->

        <div class="news-list">

            @if (Model != null && Model.Any(n => n.IsPublished))
            {
                foreach (var news in Model.Where(n => n.IsPublished))
                {
                    var category = string.IsNullOrWhiteSpace(news.Category)
                        ? "general"
                        : news.Category.Trim().ToLower();

                    var badgeClass = category switch
                    {
                        "announcements" => "announcement",
                        "events" => "event",
                        "achievements" => "achievement",
                        _ => "general"
                    };

                    var badgeText = category switch
                    {
                        "announcements" => "ANNOUNCEMENT",
                        "events" => "EVENT",
                        "achievements" => "ACHIEVEMENT",
                        _ => "GENERAL"
                    };

                    <article class="news-item"
                             data-news-category="@category"
                             data-news-id="@news.Id">

                        <!-- =================================
                             NEWS IMAGE
                             ================================= -->

                        <div class="news-thumbnail">

                            @if (!string.IsNullOrWhiteSpace(news.ImageUrl))
                            {
                                <img src="@news.ImageUrl"
                                     alt="@news.Title" />
                            }
                            else
                            {
                                <img src="/images/news/placeholder.jpg"
                                     alt="@news.Title" />
                            }

                        </div>


                        <!-- =================================
                             NEWS CONTENT
                             ================================= -->

                        <div class="news-item-content">

                            <div class="news-item-top">

                                <h3>
                                    @news.Title
                                </h3>

                                <span class="news-date">
                                    @news.PublishedDate.ToString("dd MMM yyyy")
                                </span>

                            </div>


                            <!-- =================================
                                 CATEGORY
                                 ================================= -->

                            <div class="news-meta">

                                <span class="news-badge @badgeClass">
                                    @badgeText
                                </span>

                            </div>


                            <!-- =================================
                                 DESCRIPTION
                                 ================================= -->

                            <p>
                                @news.Content
                            </p>

                        </div>

                    </article>
                }
            }

        </div>


        <!-- =================================================
             EMPTY STATE
             ================================================= -->

        <div class="news-empty"
             id="newsEmpty">

            <i class="fa-regular fa-newspaper"></i>

            <h3>
                No news found
            </h3>

            <p>
                There are currently no posts in this category.
            </p>

        </div>


        <!-- =================================================
             VIEW ALL
             ================================================= -->

        <div class="news-view-all">

            <button type="button"
                    class="btn btn-primary"
                    id="viewAllNews">

                VIEW ALL NEWS

                <i class="fa-solid fa-arrow-right"></i>

            </button>

        </div>

    </div>

</section>


<!-- =========================================================
     NEWS FILTER JAVASCRIPT
     ========================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const filters =
            document.querySelectorAll(".news-filter");

        const newsItems =
            document.querySelectorAll(".news-item");

        const newsEmpty =
            document.getElementById("newsEmpty");

        const viewAllButton =
            document.getElementById("viewAllNews");


        /* =====================================================
           FILTER NEWS
           ===================================================== */

        filters.forEach(function (filter) {

            filter.addEventListener("click", function () {

                const selectedCategory =
                    this.getAttribute("data-news-filter");


                /*
                 * Remove active class
                 * from all filter buttons.
                 */

                filters.forEach(function (button) {

                    button.classList.remove("active");

                });


                /*
                 * Add active class
                 * to selected button.
                 */

                this.classList.add("active");


                let visibleCount = 0;


                /*
                 * Loop through every article.
                 */

                newsItems.forEach(function (item) {

                    const articleCategory =
                        item.getAttribute("data-news-category");


                    /*
                     * ALL shows every article.
                     */

                    if (
                        selectedCategory === "all" ||
                        articleCategory === selectedCategory
                    ) {

                        item.style.display = "grid";

                        visibleCount++;

                    }
                    else {

                        item.style.display = "none";

                    }

                });


                /*
                 * Display empty state
                 * when no articles match.
                 */

                if (visibleCount === 0) {

                    newsEmpty.classList.add("visible");

                }
                else {

                    newsEmpty.classList.remove("visible");

                }

            });

        });


        /* =====================================================
           VIEW ALL NEWS
           ===================================================== */

        if (viewAllButton) {

            viewAllButton.addEventListener("click", function () {

                const allFilter =
                    document.querySelector(
                        '[data-news-filter="all"]'
                    );


                if (allFilter) {

                    allFilter.click();

                }


                /*
                 * Scroll back to news list.
                 */

                const newsList =
                    document.querySelector(".news-list");


                if (newsList) {

                    newsList.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });

                }

            });

        }

    });

</script>