@{
    ViewData["Title"] = "School Gallery";
}


<!-- =========================================================
     SCHOOL GALLERY HERO
     ========================================================= -->

<section class="gallery-hero">

    <div class="container gallery-hero-container">

        <div class="gallery-hero-content">

            <h1>
                SCHOOL GALLERY
            </h1>

            <h2>
                Moments that make us proud.
            </h2>

        </div>

    </div>

</section>



<!-- =========================================================
     GALLERY
     ========================================================= -->

<section class="gallery-section">

    <div class="container">


        <!-- =================================================
             GALLERY FILTERS
             ================================================= -->

        <div class="gallery-filters">

            <button type="button"
                    class="gallery-filter active"
                    data-gallery-filter="all">

                ALL

            </button>


            <button type="button"
                    class="gallery-filter"
                    data-gallery-filter="academics">

                ACADEMICS

            </button>


            <button type="button"
                    class="gallery-filter"
                    data-gallery-filter="sports">

                SPORTS

            </button>


            <button type="button"
                    class="gallery-filter"
                    data-gallery-filter="events">

                EVENTS

            </button>


            <button type="button"
                    class="gallery-filter"
                    data-gallery-filter="culture">

                CULTURE

            </button>


            <button type="button"
                    class="gallery-filter"
                    data-gallery-filter="achievements">

                ACHIEVEMENTS

            </button>

        </div>



        <!-- =================================================
             GALLERY GRID
             ================================================= -->

        <div class="gallery-grid">


            <!-- =================================================
                 IMAGE 1
                 ================================================= -->

            <button type="button"
                    class="gallery-card"
                    data-gallery-category="academics"
                    data-gallery-image="https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=1400&q=90"
                    data-gallery-title="Learning Together">

                <img src="https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=800&q=85"
                     alt="Learners participating in a classroom lesson" />

                <span class="gallery-overlay">

                    <span class="gallery-overlay-content">

                        <span class="gallery-category">
                            ACADEMICS
                        </span>

                        <strong>
                            Learning Together
                        </strong>

                        <i class="fa-solid fa-expand"></i>

                    </span>

                </span>

            </button>



            <!-- =================================================
                 IMAGE 2
                 ================================================= -->

            <button type="button"
                    class="gallery-card"
                    data-gallery-category="sports"
                    data-gallery-image="https://images.unsplash.com/photo-1461896836934-ffe607ba8211?auto=format&fit=crop&w=1400&q=90"
                    data-gallery-title="School Sports">

                <img src="https://images.unsplash.com/photo-1461896836934-ffe607ba8211?auto=format&fit=crop&w=800&q=85"
                     alt="Learners participating in sports" />

                <span class="gallery-overlay">

                    <span class="gallery-overlay-content">

                        <span class="gallery-category">
                            SPORTS
                        </span>

                        <strong>
                            School Sports
                        </strong>

                        <i class="fa-solid fa-expand"></i>

                    </span>

                </span>

            </button>



            <!-- =================================================
                 IMAGE 3
                 ================================================= -->

            <button type="button"
                    class="gallery-card"
                    data-gallery-category="events"
                    data-gallery-image="https://images.unsplash.com/photo-1529390079861-591de354faf5?auto=format&fit=crop&w=1400&q=90"
                    data-gallery-title="School Events">

                <img src="https://images.unsplash.com/photo-1529390079861-591de354faf5?auto=format&fit=crop&w=800&q=85"
                     alt="Learners and teachers at a school event" />

                <span class="gallery-overlay">

                    <span class="gallery-overlay-content">

                        <span class="gallery-category">
                            EVENTS
                        </span>

                        <strong>
                            School Events
                        </strong>

                        <i class="fa-solid fa-expand"></i>

                    </span>

                </span>

            </button>



            <!-- =================================================
                 IMAGE 4
                 ================================================= -->

            <button type="button"
                    class="gallery-card"
                    data-gallery-category="culture"
                    data-gallery-image="https://images.unsplash.com/photo-1564399579883-451a5d44ec08?auto=format&fit=crop&w=1400&q=90"
                    data-gallery-title="Reading Together">

                <img src="https://images.unsplash.com/photo-1564399579883-451a5d44ec08?auto=format&fit=crop&w=800&q=85"
                     alt="Learners reading together" />

                <span class="gallery-overlay">

                    <span class="gallery-overlay-content">

                        <span class="gallery-category">
                            CULTURE
                        </span>

                        <strong>
                            Reading Together
                        </strong>

                        <i class="fa-solid fa-expand"></i>

                    </span>

                </span>

            </button>



            <!-- =================================================
                 IMAGE 5
                 ================================================= -->

            <button type="button"
                    class="gallery-card"
                    data-gallery-category="culture"
                    data-gallery-image="https://images.unsplash.com/photo-1504150558240-0b4fd8946624?auto=format&fit=crop&w=1400&q=90"
                    data-gallery-title="Celebrating Our Culture">

                <img src="https://images.unsplash.com/photo-1504150558240-0b4fd8946624?auto=format&fit=crop&w=800&q=85"
                     alt="Learners celebrating school culture" />

                <span class="gallery-overlay">

                    <span class="gallery-overlay-content">

                        <span class="gallery-category">
                            CULTURE
                        </span>

                        <strong>
                            Celebrating Our Culture
                        </strong>

                        <i class="fa-solid fa-expand"></i>

                    </span>

                </span>

            </button>



            <!-- =================================================
                 IMAGE 6
                 ================================================= -->

            <button type="button"
                    class="gallery-card"
                    data-gallery-category="events"
                    data-gallery-image="https://images.unsplash.com/photo-1504274066651-8d31a536b11a?auto=format&fit=crop&w=1400&q=90"
                    data-gallery-title="Making Memories">

                <img src="https://images.unsplash.com/photo-1504274066651-8d31a536b11a?auto=format&fit=crop&w=800&q=85"
                     alt="Learners enjoying a school activity" />

                <span class="gallery-overlay">

                    <span class="gallery-overlay-content">

                        <span class="gallery-category">
                            EVENTS
                        </span>

                        <strong>
                            Making Memories
                        </strong>

                        <i class="fa-solid fa-expand"></i>

                    </span>

                </span>

            </button>



            <!-- =================================================
                 IMAGE 7
                 ================================================= -->

            <button type="button"
                    class="gallery-card"
                    data-gallery-category="achievements"
                    data-gallery-image="https://images.unsplash.com/photo-1577896851231-70ef18881754?auto=format&fit=crop&w=1400&q=90"
                    data-gallery-title="Celebrating Achievement">

                <img src="https://images.unsplash.com/photo-1577896851231-70ef18881754?auto=format&fit=crop&w=800&q=85"
                     alt="Learners celebrating an achievement" />

                <span class="gallery-overlay">

                    <span class="gallery-overlay-content">

                        <span class="gallery-category">
                            ACHIEVEMENTS
                        </span>

                        <strong>
                            Celebrating Achievement
                        </strong>

                        <i class="fa-solid fa-expand"></i>

                    </span>

                </span>

            </button>



            <!-- =================================================
                 IMAGE 8
                 ================================================= -->

            <button type="button"
                    class="gallery-card"
                    data-gallery-category="achievements"
                    data-gallery-image="https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&w=1400&q=90"
                    data-gallery-title="Our Proud Moments">

                <img src="https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&w=800&q=85"
                     alt="Learners celebrating a school achievement" />

                <span class="gallery-overlay">

                    <span class="gallery-overlay-content">

                        <span class="gallery-category">
                            ACHIEVEMENTS
                        </span>

                        <strong>
                            Our Proud Moments
                        </strong>

                        <i class="fa-solid fa-expand"></i>

                    </span>

                </span>

            </button>

        </div>



        <!-- =================================================
             EMPTY STATE
             ================================================= -->

        <div class="gallery-empty"
             id="galleryEmpty">

            <i class="fa-regular fa-images"></i>

            <h3>
                No photos found
            </h3>

            <p>
                There are currently no photos in this category.
            </p>

        </div>



        <!-- =================================================
             VIEW MORE
             ================================================= -->

        <div class="gallery-more">

            <button type="button"
                    class="btn btn-primary"
                    id="viewMoreGallery">

                VIEW MORE PHOTOS

                <i class="fa-solid fa-arrow-right"></i>

            </button>

        </div>

    </div>

</section>



<!-- =========================================================
     IMAGE LIGHTBOX
     ========================================================= -->

<div class="gallery-lightbox"
     id="galleryLightbox"
     aria-hidden="true">

    <div class="gallery-lightbox-backdrop"></div>


    <div class="gallery-lightbox-content"
         role="dialog"
         aria-modal="true"
         aria-label="Gallery image viewer">

        <button type="button"
                class="gallery-lightbox-close"
                id="galleryLightboxClose"
                aria-label="Close image">

            <i class="fa-solid fa-xmark"></i>

        </button>


        <button type="button"
                class="gallery-lightbox-prev"
                id="galleryLightboxPrev"
                aria-label="Previous image">

            <i class="fa-solid fa-chevron-left"></i>

        </button>


        <img id="galleryLightboxImage"
             src=""
             alt="" />


        <button type="button"
                class="gallery-lightbox-next"
                id="galleryLightboxNext"
                aria-label="Next image">

            <i class="fa-solid fa-chevron-right"></i>

        </button>


        <div class="gallery-lightbox-caption">

            <span id="galleryLightboxCategory">
                GALLERY
            </span>

            <h3 id="galleryLightboxTitle">
                School Gallery
            </h3>

        </div>

    </div>

</div>
